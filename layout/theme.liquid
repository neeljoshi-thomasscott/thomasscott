    <script>
    // ================================================================
    // 1. GLOBAL UTILITY FUNCTIONS
    // ================================================================

    function plpAtc(btn) {
      var variantId = btn.dataset.variantId;
      if (!variantId) return;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(function (r) { return r.json(); })
      .then(function () {
        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: { data: { itemCount: 1, source: 'th-product-card' } }
        }));
      })
      .catch(console.error);
    }

    function toggleAddToCart(btn, hide) {
      var card = document.querySelector(btn.getAttribute('data-card'));
      if (!card) return;

      var isMobile = window.innerWidth <= 768;
      var sizeSelectorDiv = card.querySelector(btn.getAttribute('data-size-variant-selector'));
      var quickAddBtnId = btn.getAttribute('data-quick-add-btn');
      var globalSelector = btn.getAttribute('data-global-card');
      var sizeSelector = btn.getAttribute('data-size-variant-selector');

      // Close all other open selectors
      if (globalSelector && sizeSelector) {
        document.querySelectorAll(globalSelector).forEach(function (el) {
          var other = el.querySelector(sizeSelector);
          if (other) { other.classList.remove('active'); other.setAttribute('hidden', true); }
        });
      }

      if (!isMobile) {
        // ---- DESKTOP: show/hide size selector ----
        if (!sizeSelectorDiv) return;
        if (hide === true) {
          sizeSelectorDiv.classList.remove('active');
          sizeSelectorDiv.setAttribute('hidden', true);
        } else {
          sizeSelectorDiv.classList.add('active');
          sizeSelectorDiv.removeAttribute('hidden');
        }
      } else {
        // ---- MOBILE: open quick-add modal ----
        // Try 1: find the mobile quick-add button by ID and call its
        //        parent quick-add-component's handleClick directly
        var mobileBtn = quickAddBtnId
          ? (document.getElementById(quickAddBtnId) || card.querySelector('[id="' + quickAddBtnId + '"]'))
          : null;

        // Fallback: any .quick-add-btn-mobile inside this card
        if (!mobileBtn) mobileBtn = card.querySelector('.quick-add-btn-mobile');

        if (mobileBtn) {
          var qaComponent = mobileBtn.closest('quick-add-component');

          if (qaComponent && typeof qaComponent.handleClick === 'function') {
            // Shopify custom element method — most reliable
            qaComponent.handleClick(new MouseEvent('click', { bubbles: true, cancelable: true }));
          } else {
            // Fallback: native click on the button itself
            mobileBtn.click();
          }
        }
      }
    }

    async function triggerAddToCartDesktop(btn) {
      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) { alert('Variant ID is missing'); return; }
      var card = document.querySelector(btn.getAttribute('data-card'));
      var sizeVariants = card && card.querySelector(btn.getAttribute('data-size-variant-selector'));

      function setLoading(state) {
        btn.classList.toggle('loading', state);
        btn.toggleAttribute('disabled', state);
      }

      try {
        setLoading(true);
        var res = await fetch(window.Shopify.routes.root + 'cart/add.js?sections=cart-count', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
        });
        if (!res.ok) {
          var err = await res.json().catch(function () { return {}; });
          throw new Error(err.description || 'Unable to add item to cart.');
        }
        var data = await res.json();
        var html = data && data.sections && data.sections['cart-count'];
        if (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var count = parseInt(doc.body.textContent && doc.body.textContent.trim(), 10) || 0;
          if (sizeVariants) sizeVariants.setAttribute('hidden', true);
          document.dispatchEvent(new CustomEvent('cart:update', {
            bubbles: true,
            detail: { data: { itemCount: count, source: 'th-product-card' } }
          }));
          initMiniCartProductRecommendations();
        }
      } catch (e) {
        console.error(e);
      } finally {
        setLoading(false);
      }
    }

    async function loadSwatchCard(btn) {
      var url = btn.getAttribute('data-variant-url').split('?')[0];
      var card = document.querySelector(btn.getAttribute('data-card'));
      btn.classList.add('loading');
      try {
        var res = await fetch(url + '?section_id=th-product-card');
        var html = await res.text();
        var doc = new DOMParser().parseFromString(html, 'text/html');
        doc.querySelectorAll('script').forEach(function (s) { s.remove(); });
        var newCard = doc.querySelector('.custom-product-card');
        if (newCard && card) {
          var uid = 'uid_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
          card.id = (newCard.id || '') + '_' + uid;
          card.className = Array.from(newCard.classList).map(function (c) { return c + ' _' + uid; }).join(' ');
          card.innerHTML = newCard.innerHTML;
        }
      } catch (e) { console.error(e); }
      btn.classList.remove('loading');
    }

    function initMiniCartProductRecommendations() {
      document.querySelectorAll('cart-drawer-component product-recommendations').forEach(function (el) {
        el.dataset.recommendationsPerformed = 'false';
        el.classList.remove('hidden');
      });
    }

    function clearUnavailableVariants(root) {
      (root || document).querySelectorAll('variant-picker').forEach(function (picker) {
        var radios = Array.from(picker.querySelectorAll('input[type="radio"][data-option-available]'));
        if (!radios.length) return;
        var allUnavailable = radios.every(function (r) { return r.dataset.optionAvailable === 'false'; });
        if (!allUnavailable) return;
        radios.forEach(function (radio) {
          radio.checked = false;
          radio.removeAttribute('checked');
          radio.dataset.currentChecked = 'false';
          radio.dataset.previousChecked = 'false';
        });
        var label = picker.querySelector('.size-variant-label');
        if (label) label.textContent = '';
      });
    }

   
    document.addEventListener('DOMContentLoaded', function () {

      // Footer accordion
      document.querySelectorAll('.footer-col').forEach(function (tab) {
        var btn = tab.querySelector('.footer-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          document.querySelectorAll('.footer-col').forEach(function (el) {
            if (el !== tab) el.classList.remove('active');
          });
          tab.classList.toggle('active');
        });
      });

      // Quick-add dialog close button → remove overlay
      var qaClose = document.querySelector('#quick-add-dialog .close-button');
      if (qaClose) {
        qaClose.addEventListener('click', function () {
          document.body.classList.remove('popup-overlay');
        });
      }

      // Nav menu open overlay
      var menuBtn = document.querySelector('.nav-icon');
      if (menuBtn) {
        menuBtn.addEventListener('click', function () {
          document.body.classList.add('popup-overlay');
        });
      }

      // Buy Now text normalise
      function updateBuyNowText() {
        var btn = document.querySelector('.shopify-payment-button__button');
        if (btn && btn.textContent.trim() !== 'Buy now') btn.textContent = 'Buy now';
      }
      updateBuyNowText();
      new MutationObserver(updateBuyNowText).observe(
        document.querySelector('.shopify-payment-button') || document.body,
        { childList: true, subtree: true }
      );

      // OOS variants — PDP
      clearUnavailableVariants(document);

    });

    // ================================================================
    // 3. DELEGATED CLICK HANDLER — popup overlay management
    // ================================================================
    document.body.addEventListener('click', function (e) {

      // Open mini cart overlay
      if (e.target.closest('[data-testid="cart-drawer-trigger"]')) {
        setTimeout(function () { document.body.classList.add('popup-overlay'); }, 100);
        return;
      }

      // Close mini cart / header drawer
      if (e.target.closest('.cart-drawer__close-button') || e.target.closest('.header-close-btn')) {
        document.body.classList.remove('popup-overlay');
        return;
      }

      // Close quick-add modal via X button
      var qaClose = e.target.closest('.quick-add-modal__close');
      if (qaClose) {
        var dlg = qaClose.closest('dialog');
        if (dlg) dlg.close();
        document.body.classList.remove('popup-overlay');
        return;
      }

      // Close on dialog backdrop
      if (e.target.matches('.dialog-modal') || e.target.matches('dialog[open]')) {
        document.body.classList.remove('popup-overlay');
        return;
      }

      // Close after add-to-cart
      if (e.target.closest('.add-to-cart-button')) {
        document.body.classList.remove('popup-overlay');
        return;
      }

      // Mobile product card bag icon → add overlay (modal about to open)
      if (e.target.closest('.quick-add-btn') && window.innerWidth < 768) {
        setTimeout(function () { document.body.classList.add('popup-overlay'); }, 100);
        return;
      }

    });

 
  
// ================================================================
// 4. IMAGE SLIDER — fixed: no double init, locked guard, dots on mobile
// ================================================================
(function () {
  'use strict';

  function initSlider(slider) {
    if (slider.dataset.sliderReady === '1') return;
    slider.dataset.sliderReady = '1';

    var track = slider.querySelector('[data-card-track]');
    if (!track) return;

    var origSlides = Array.from(track.querySelectorAll('.product-image-slide'));
    if (origSlides.length <= 1) return;

    var total = origSlides.length;
    var prevBtn = slider.querySelector('[data-card-prev]');
    var nextBtn = slider.querySelector('[data-card-next]');
    var dotsContainer = slider.querySelector('[data-card-dots]');

    // Build dots
    var dots = [];
    if (dotsContainer) {
      origSlides.forEach(function (_, i) {
        var d = document.createElement('button');
        d.setAttribute('aria-label', 'Go to image ' + (i + 1));
        d.addEventListener('click', function () { goToReal(i); });
        dotsContainer.appendChild(d);
        dots.push(d);
      });
    }

    function updateDots(realIndex) {
      dots.forEach(function (d, i) {
        d.classList.toggle('is-active', i === realIndex);
      });
    }

    // Clones for infinite loop
    var firstClone = origSlides[0].cloneNode(true);
    var lastClone  = origSlides[total - 1].cloneNode(true);
    firstClone.dataset.clone = 'true';
    lastClone.dataset.clone  = 'true';
    track.appendChild(firstClone);
    track.insertBefore(lastClone, origSlides[0]);
    track.style.transition = 'none';
    track.style.transform = 'translateX(-100%)';

    var allSlides = track.querySelectorAll('.product-image-slide');
    var cur = 1;
    var locked = false;
    var lockTimer = null;

    function realIndex(i) {
      // clamp to 0-based real index (cur 1 = real 0)
      return ((i - 1) % total + total) % total;
    }

    function go(index, animate) {
      track.style.transition = animate
        ? 'transform 0.38s cubic-bezier(.25,.46,.45,.94)'
        : 'none';
      track.style.transform = 'translateX(-' + (index * 100) + '%)';
      cur = index;
      updateDots(realIndex(cur));
    }

    // Safety unlock — if transitionend misfires, release after 450ms
    function safeLock() {
      locked = true;
      clearTimeout(lockTimer);
      lockTimer = setTimeout(function () {
        locked = false;
        // also fix position if we're on a clone
        if (cur >= allSlides.length - 1) go(1, false);
        else if (cur <= 0) go(allSlides.length - 2, false);
      }, 450);
    }

    function next() { if (!locked) { safeLock(); go(cur + 1, true); } }
    function prev() { if (!locked) { safeLock(); go(cur - 1, true); } }

    track.addEventListener('transitionend', function () {
      clearTimeout(lockTimer);
      locked = false;
      if (cur >= allSlides.length - 1) go(1, false);
      else if (cur <= 0) go(allSlides.length - 2, false);
    });

    if (nextBtn) nextBtn.addEventListener('click', function (e) { e.preventDefault(); next(); });
    if (prevBtn) prevBtn.addEventListener('click', function (e) { e.preventDefault(); prev(); });

    function goToReal(i) {
      if (!locked) { safeLock(); go(i + 1, true); }
    }

    // ---- Touch: follow finger live ----
    var startX = 0, startY = 0, dragging = false, axisLocked = false, isVertical = false;

    track.addEventListener('touchstart', function (e) {
      if (locked) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      dragging = true;
      axisLocked = false;
      isVertical = false;
      track.style.transition = 'none';
    }, { passive: true });

    track.addEventListener('touchmove', function (e) {
      if (!dragging) return;
      var dx = startX - e.touches[0].clientX;
      var dy = startY - e.touches[0].clientY;

      // Determine axis on first significant move
      if (!axisLocked && (Math.abs(dx) > 5 || Math.abs(dy) > 5)) {
        isVertical = Math.abs(dy) > Math.abs(dx);
        axisLocked = true;
      }

      if (isVertical) {
        // Abort horizontal drag, restore position
        dragging = false;
        go(cur, false);
        return;
      }

      track.style.transform = 'translateX(calc(-' + (cur * 100) + '% - ' + dx + 'px))';
    }, { passive: true }); 
  


    track.addEventListener('touchend', function (e) {
      if (!dragging) return;
      dragging = false;
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        diff > 0 ? next() : prev();
      } else {
        go(cur, true);
      }
    });

    track.addEventListener('touchcancel', function () {
      if (dragging) { dragging = false; go(cur, true); }
    });

  track.style.transition = 'none';
    track.style.transform = 'translateX(-100%)';
    cur = 1;
    updateDots(0);
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        track.style.transition = '';
      });
    });
  }

  function initAll(root) {
    (root || document).querySelectorAll('[data-card-slider]').forEach(initSlider);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });

  new MutationObserver(function (mutations) {
    mutations.forEach(function (m) {
      m.addedNodes.forEach(function (node) {
        if (node.nodeType !== 1) return;
        if (node.matches && node.matches('[data-card-slider]')) initSlider(node);
        else if (node.querySelectorAll) initAll(node);
      });
    });
  }).observe(document.body, { childList: true, subtree: true });

})();


    // ================================================================
    // 5. OOS VARIANT OBSERVER — quick-add modal
    // ================================================================
    new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
          if (node.nodeType !== 1) return;
          var modal = node.id === 'quick-add-modal-content'
            ? node : (node.querySelector && node.querySelector('#quick-add-modal-content'));
          if (modal) {
            setTimeout(function () { clearUnavailableVariants(modal); }, 0);
            setTimeout(function () { clearUnavailableVariants(modal); }, 250);
          }
        });
        if (mutation.type === 'childList') {
          var t = mutation.target;
          var modal = (t.id === 'quick-add-modal-content')
            ? t : (t.closest && t.closest('#quick-add-modal-content'));
          if (modal) setTimeout(function () { clearUnavailableVariants(modal); }, 0);
        }
      });
    }).observe(document.body, { childList: true, subtree: true });

    // ================================================================
// FIX: Clear popup-overlay state on back navigation
// ================================================================
window.addEventListener('pageshow', function (e) {
  var scrollY = parseInt(document.body.style.top || '0') * -1;
  document.body.classList.remove('popup-overlay');
  document.body.style.top = '';
  document.body.style.position = '';
  document.body.style.width = '';
  if (scrollY) {
    window.scrollTo({ top: scrollY, behavior: 'instant' });
  }
});

    </script>
