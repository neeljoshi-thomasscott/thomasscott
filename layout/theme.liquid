      img { max-width: 100%; }

      /* ---- Btn Loader ---- */
      .btn-loader { position: relative; }
      .btn-loader .loader {
        position: absolute; inset: 0;
        display: none; align-items: center; justify-content: center;
        width: 100%; padding: 6px; opacity: 0; z-index: -1; height: 100%;
        border:0;
      }
      .btn-loader .loaded { display: block; }
      .btn-loader.loading .loader { display: flex; opacity: 1; z-index: 9; }
      .btn-loader.loading .loaded { visibility: hidden; }
      .btn-loader .spinner { width: 100%; height: 100%; animation: rotate 1s linear infinite; }
      .btn-loader .path { stroke: currentColor; stroke-linecap: round; animation: dash 1.2s ease-in-out infinite; }
      .color-swatch.btn-loader .loader { padding: 3px; background-color: rgba(255,255,255,0.6); }
      @keyframes rotate { 100% { transform: rotate(360deg); } }
      @keyframes dash {
        0%   { stroke-dasharray: 1, 120;  stroke-dashoffset: 0; }
        50%  { stroke-dasharray: 60, 120; stroke-dashoffset: -20; }
        100% { stroke-dasharray: 60, 120; stroke-dashoffset: -90; }
      }

