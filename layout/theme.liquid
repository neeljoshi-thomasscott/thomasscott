      /* ---- Image Slider ---- */
      .product-image-slider { position: relative; overflow: hidden; width: 100%; }
       .product-image-track {
        display: flex;
        will-change: transform;
        visibility: hidden;
      }
      [data-card-slider][data-slider-ready="1"] .product-image-track {
        visibility: visible;
      }
      .product-image-slide { min-width: 100%; flex: 0 0 100%; }
      .product-image-slide a,
      .product-image-slide img { display: block; width: 100%; pointer-events: none; user-select: none; -webkit-user-drag: none; }
      .product-image-slide a { pointer-events: auto; }

      .card-slider-btn {
        position: absolute; top: 50%; transform: translateY(-50%);
        width: 20px; height: 20px; border: 0; border-radius: 50%;
        background: rgba(0,0,0,0.45); color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transition: .3s; z-index: -1;
      }
      .card-slider-btn.prev { left: 8px; }
      .card-slider-btn.next { right: 8px; }
      button.card-slider-btn.prev svg { transform: rotate(180deg); }

      .card-slider-dots {
        position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%);
        display: flex; gap: 6px; z-index: 2;
      }
      .card-slider-dots button {
        width: 7px; height: 7px; border: 0; border-radius: 50%;
        background: rgba(255,255,255,.5); padding: 0; cursor: pointer;
      }
      .card-slider-dots button.is-active { background: #fff; }

      @media screen and (min-width: 768px) {
        .product-image-slider:hover .card-slider-btn { opacity: 1; z-index: 2; }
      }
      @media screen and (max-width: 767px) {
        .product-image-slider:hover .card-slider-btn { opacity: 1; z-index: 2; }
        .swiper .card-slider-btn { width: 16px; height: 16px; }
        .card-slider-btn.prev { left: 4px; }
        .card-slider-btn.next { right: 4px; }
        .watch-buy-card .product-mini-card { opacity: 1; visibility: visible; }
