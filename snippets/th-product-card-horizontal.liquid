{%- liquid
  assign featured_variant = product.selected_or_first_available_variant
  assign add_to_cart_label = 'products.product.add_to_cart' | t
-%}

<th-product-card
  class="th-product-card shop-look-card"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-section-id="{{ section.id | default: 'th-product-card' }}"
>

        <product-card-link
          data-product-id="{{ resource.id }}"
          data-featured-media-url="{{ featured_media_url }}"
          data-product-transition="true"
          on:click="/handleViewTransition"
        >
          <product-card data-product-id="{{ product.id }}">
            <a
              id="{{ product.id | md5 }}"
              {% unless onboarding %}
                href="{{ product.selected_or_first_available_variant.url }}"
              {% endunless %}
              class="product-card__link"
              ref="productCardLink"
            >
              <span class="visually-hidden">
                {{ product.title }}
              </span>
            </a>

	<div class="shop-look-thumb">
		<a href="{{ product.url }}">
    <img src="{{ product.featured_image | image_url: width: '100px' }}" alt="{{ product.featured_image.alt }}" class="w-full ls-is-cached lazyloaded" loading="lazy" width="134" height="146">
		</a>
	</div>
	<div class="shop-look-content">
		<div class="thomassmheading">
			<a href="{{ product.url }}">{{ product.title }}</a>
		</div>
		<div class="shop-look-details">
			{% render 'price', product_resource: product %}
<div
        class="inline-variant-selector"
        id="variant-selector-{{ product.id }}"
        data-inline-selector
        hidden
        >
        <div class="select-size">
          Select Size
        </div>
        <div class="size-buttons">
          {%- for variant in product.variants -%}
          {%- assign option_label = variant.option1 | default: variant.title -%}
          <button
          class="size-btn btn-loader"
          type="button"
          data-variant-id="{{ variant.id }}"
          data-variant-title="{{ option_label | escape }}"
          data-available="{{ variant.available }}"
          {% unless variant.available %}
          disabled
          aria-disabled="true"
          {% endunless %}
          >
          <span class="loader">
            <svg class="spinner" viewBox="0 0 50 50">
              <circle
                class="path"
                cx="25"
                cy="25"
                r="20"
                fill="none"
                stroke-width="4"
                />
            </svg>
          </span>
          <span class="loaded">
          {{ option_label }}
          </span>
          </button>
          {%- endfor -%}
        </div>
      </div>
			<button class="shop-look-cart"
      type="button"
                    data-product-id="{{ product.id }}"
                    data-quick-add-trigger
                    aria-expanded="false"
                    aria-controls="variant-selector-{{ product.id }}"
                    aria-label="{{ add_to_cart_label | escape }}">
				<svg width="18" height="19" viewBox="0 0 18 19" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M12.074 8.0625V3.9375C12.074 3.02582 11.7119 2.15148 11.0672 1.50682C10.4225 0.862164 9.5482 0.5 8.63652 0.5C7.72484 0.5 6.8505 0.862164 6.20584 1.50682C5.56119 2.15148 5.19902 3.02582 5.19902 3.9375V8.0625M15.6087 6.23558L16.7664 17.2356C16.8306 17.8452 16.3539 18.375 15.7407 18.375H1.53236C1.38771 18.3752 1.24465 18.3449 1.11247 18.2861C0.980295 18.2274 0.86195 18.1415 0.765126 18.0341C0.668303 17.9266 0.595168 17.8 0.550472 17.6624C0.505775 17.5249 0.490517 17.3794 0.505689 17.2356L1.66436 6.23558C1.69108 5.98218 1.81068 5.74764 2.00008 5.57719C2.18949 5.40674 2.4353 5.31245 2.69011 5.3125H14.5829C15.1109 5.3125 15.5537 5.71125 15.6087 6.23558ZM5.54277 8.0625C5.54277 8.15367 5.50656 8.2411 5.44209 8.30557C5.37762 8.37003 5.29019 8.40625 5.19902 8.40625C5.10785 8.40625 5.02042 8.37003 4.95595 8.30557C4.89149 8.2411 4.85527 8.15367 4.85527 8.0625C4.85527 7.97133 4.89149 7.8839 4.95595 7.81943C5.02042 7.75497 5.10785 7.71875 5.19902 7.71875C5.29019 7.71875 5.37762 7.75497 5.44209 7.81943C5.50656 7.8839 5.54277 7.97133 5.54277 8.0625ZM12.4178 8.0625C12.4178 8.15367 12.3816 8.2411 12.3171 8.30557C12.2526 8.37003 12.1652 8.40625 12.074 8.40625C11.9829 8.40625 11.8954 8.37003 11.831 8.30557C11.7665 8.2411 11.7303 8.15367 11.7303 8.0625C11.7303 7.97133 11.7665 7.8839 11.831 7.81943C11.8954 7.75497 11.9829 7.71875 12.074 7.71875C12.1652 7.71875 12.2526 7.75497 12.3171 7.81943C12.3816 7.8839 12.4178 7.97133 12.4178 8.0625Z" stroke="white" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>
	</div>






  {% comment %}
  <product-form-component>
    {%- form 'product', product, id: 'th-product-form-' | append: product.id, class: 'th-product-card__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ featured_variant.id }}" data-selected-variant-input>
      <input type="hidden" name="quantity" value="1">
      <button type="submit" hidden data-hidden-submit>{{ add_to_cart_label }}</button>
    {%- endform -%}
  </product-form-component>
  {% endcomment %}

          </product-card>
        </product-card-link>
  
</th-product-card>