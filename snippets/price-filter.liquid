    padding: var(--padding-xs) 0 var(--padding-sm);
  }
  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }
  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }

  /* ── Dual Range Slider ── */
  .price-range-slider {
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-range-slider__labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-paragraph--size);
    margin-bottom: 10px;
    color: var(--color-foreground, currentColor);
    font-weight: 500;
    min-height: 1.4em;
  }

  .price-range-slider__label-min,
  .price-range-slider__label-max {
    display: block;
  }

  .price-range-slider__track-wrapper {
    position: relative;
    height: 20px;
    display: flex;
    align-items: center;
  }

  .price-range-slider__track {
    position: absolute;
    left: 0;
    right: 0;
    height: 4px;
    background-color: #1a1a1a;
    border-radius: 2px;
    pointer-events: none;
  }
  .price-range-slider__track:after{
    content:'';
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #090909;
    top:0;
    border-radius: 2px;
    z-index: 1;
  }

  .price-range-slider__range {
    position: absolute;
    height: 100%;
    background-color: #ffffff;
    border-radius: 2px;
  }

  .price-range-slider__input {
    position: absolute;
    left: 0;
    width: 100%;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    pointer-events: none;
    outline: none;
    margin: 0;
  }

  /* Thumb – WebKit */
  .price-range-slider__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid #1a1a1a;
    cursor: pointer;
    pointer-events: all;
    position: relative;
    z-index: 1;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .price-range-slider__input::-webkit-slider-thumb:hover,
  .price-range-slider__input::-webkit-slider-thumb:active {
    transform: scale(1.15);
    box-shadow: 0 0 0 5px rgba(0, 0, 0, 0.1);
  }

  /* Thumb – Firefox */
  .price-range-slider__input::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 2px solid #1a1a1a;
    cursor: pointer;
    pointer-events: all;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .price-range-slider__input::-moz-range-thumb:hover,
  .price-range-slider__input::-moz-range-thumb:active {
    transform: scale(1.15);
    box-shadow: 0 0 0 5px rgba(0, 0, 0, 0.1);
  }

  /* Keep min thumb on top when sliders overlap on the left */
  .price-range-slider__input--min {
    z-index: 2;
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    // Strip commas, currency symbols etc — Shopify money_without_currency can output "3,999"
    function parseNum(str) {
      return parseFloat(String(str).replace(/[^\d.]/g, '')) || 0;
    }

    function initPriceRangeSlider(wrapper) {
      const rangeMin  = parseNum(wrapper.dataset.rangeMin);
      const rangeMax  = parseNum(wrapper.dataset.rangeMax);
      const currency  = wrapper.dataset.currencySymbol || '';

      const sliderMin = wrapper.querySelector('.price-range-slider__input--min');
      const sliderMax = wrapper.querySelector('.price-range-slider__input--max');
      const rangeBar  = wrapper.querySelector('.price-range-slider__range');
      const labelMin  = wrapper.querySelector('.price-range-slider__label-min');
      const labelMax  = wrapper.querySelector('.price-range-slider__label-max');

      // Fix slider min/max attrs to use clean parsed numbers (no commas)
      sliderMin.min   = rangeMin;
      sliderMin.max   = rangeMax;
      sliderMax.min   = rangeMin;
      sliderMax.max   = rangeMax;

      // Set initial values cleanly
      const initMin   = parseNum(sliderMin.value) || rangeMin;
      const initMax   = parseNum(sliderMax.value) || rangeMax;
      sliderMin.value = initMin;
      sliderMax.value = initMax;

      const facetComp = wrapper.closest('price-facet-component');
      const inputMin  = facetComp ? facetComp.querySelector('[ref="minInput"]') : null;
      const inputMax  = facetComp ? facetComp.querySelector('[ref="maxInput"]') : null;

      function formatPrice(val) {
        return currency + Math.round(val).toLocaleString('en-IN');
      }

      function updateTrack() {
        const minVal = parseNum(sliderMin.value);
        const maxVal = parseNum(sliderMax.value);
        const minPct = ((minVal - rangeMin) / (rangeMax - rangeMin)) * 100;
        const maxPct = ((maxVal - rangeMin) / (rangeMax - rangeMin)) * 100;
        rangeBar.style.left  = minPct + '%';
        rangeBar.style.width = (maxPct - minPct) + '%';
        labelMin.textContent = formatPrice(minVal);
        labelMax.textContent = formatPrice(maxVal);
      }

      /**
       * Use native value setter so web-component internal watchers fire correctly.
       */
      function setNativeValue(el, val) {
        if (!el) return;
        const nativeSetter = Object.getOwnPropertyDescriptor(
          window.HTMLInputElement.prototype, 'value'
        ).set;
        nativeSetter.call(el, val);
        el.dispatchEvent(new Event('input',  { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
      }

      // While dragging — update visuals only
      sliderMin.addEventListener('input', () => {
        if (parseNum(sliderMin.value) > parseNum(sliderMax.value)) {
          sliderMin.value = sliderMax.value;
        }
        updateTrack();
      });

      sliderMax.addEventListener('input', () => {
        if (parseNum(sliderMax.value) < parseNum(sliderMin.value)) {
          sliderMax.value = sliderMin.value;
        }
        updateTrack();
      });

      // On drag-end — sync hidden inputs & trigger Shopify filter
      function onDragEnd() {
        const minVal = parseNum(sliderMin.value);
        const maxVal = parseNum(sliderMax.value);
        setNativeValue(inputMin, minVal > rangeMin ? String(minVal) : '');
        setNativeValue(inputMax, maxVal < rangeMax ? String(maxVal) : '');
      }

      sliderMin.addEventListener('change', onDragEnd);
      sliderMax.addEventListener('change', onDragEnd);

      // Initial render — show labels immediately
      updateTrack();
    }

    function init() {
      document.querySelectorAll('.price-range-slider').forEach((wrapper) => {
        if (wrapper.dataset.priceSliderInit) return;
        wrapper.dataset.priceSliderInit = '1';
        initPriceRangeSlider(wrapper);
      });
    }

    // Re-init on Shopify AJAX section loads
    document.addEventListener('shopify:section:load', () => {
      document.querySelectorAll('.price-range-slider').forEach(
        (w) => delete w.dataset.priceSliderInit
      );
      init();
    });

    // MutationObserver — catches Shopify filter AJAX DOM replacements
    // (facets re-render injects new HTML; section:load does NOT fire for filter updates)
    const observer = new MutationObserver(() => {
      document.querySelectorAll('.price-range-slider:not([data-price-slider-init])').forEach((wrapper) => {
        wrapper.dataset.priceSliderInit = '1';
        initPriceRangeSlider(wrapper);
      });
    });

    observer.observe(document.body, { childList: true, subtree: true });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
{% endjavascript %}





