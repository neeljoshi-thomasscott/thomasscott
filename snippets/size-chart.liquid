<style>
.size-modal {
  width: 100%;
  max-width: 100%;
  height: 100%;
  max-height: 100%;
  display: none;
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: rgba(0,0,0,0.5);
  overflow:hidden;
}

.size-modal-content {
  background: #fff;
  max-width: 600px;
  margin: 5% auto;
  padding: 20px;
  position: relative;
}

.close-size {
  position: absolute;
  right: 15px;
  top: 10px;
  cursor: pointer;
  font-size: 22px;
}

.size-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

.size-table th,
.size-table td {
  border: 1px solid #ddd;
  padding: 10px;
  text-align: center;
}
</style>
