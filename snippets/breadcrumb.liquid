
<div class="container">
  <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    
    <a href="{{ routes.root_url }}" data-track="breadcrumb_click" data-track-label="Home">Home</a>
    {% capture separator %}
      <span class="breadcrumb-separator">
        <svg width="6" height="6" viewBox="0 0 6 6" fill="none">
          <circle cx="3" cy="3" r="3" fill="#CDCDCF"/>
        </svg>
      </span>
    {% endcapture %}

    {%- comment -%}
      Parent category lookup from the header menus (Shirts > Formal etc.).
      bc_menu_json maps "/collections/x" -> top-level menu item {t,u}.
      First menu match wins.
    {%- endcomment -%}
    {%- assign bc_menus = 'liberty-left,right-menu-1' | split: ',' -%}
    {%- assign bc_seen = '|' -%}
    {%- capture bc_menu_json -%}{%- if template contains 'product' -%}
      {%- for mh in bc_menus -%}
        {%- for top in linklists[mh].links -%}
          {%- if top.links.size > 0 -%}
            {%- assign top_path = top.url | split: '?' | first -%}
            {%- for child in top.links -%}
              {%- assign child_path = child.url | split: '?' | first -%}
              {%- assign key = '|' | append: child_path | append: '|' -%}
              {%- if child_path contains '/collections/' and child_path != top_path -%}
                {%- unless bc_seen contains key -%}
                  {%- assign bc_seen = bc_seen | append: child_path | append: '|' -%}
                  {{ child_path | json }}:{"t":{{ top.title | json }},"u":{{ top_path | json }}},
                {%- endunless -%}
              {%- endif -%}
              {%- for grand in child.links -%}
                {%- assign grand_path = grand.url | split: '?' | first -%}
                {%- assign key = '|' | append: grand_path | append: '|' -%}
                {%- if grand_path contains '/collections/' and grand_path != top_path -%}
                  {%- unless bc_seen contains key -%}
                    {%- assign bc_seen = bc_seen | append: grand_path | append: '|' -%}
                    {{ grand_path | json }}:{"t":{{ top.title | json }},"u":{{ top_path | json }}},
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}{%- endcapture -%}

    {% if template contains 'product' %}

      {%- comment -%}
        Fallback when we don't know where the shopper came from:
        first collection that isn't a sale/offer collection.
      {%- endcomment -%}
      {% assign first_collection = nil %}
      {% for c in product.collections %}
        {% unless c.handle contains 'sale' or c.handle contains 'black-friday' or c.handle contains 'offer' %}
          {% assign first_collection = c %}
          {% break %}
        {% endunless %}
      {% endfor %}
      {% if first_collection == nil %}
        {% assign first_collection = product.collections.first %}
      {% endif %}

      {% if collection %}
        {% render 'breadcrumb-parent', path: collection.url, separator: separator %}
        {{ separator }}
        <a href="{{ collection.url }}" data-breadcrumb-collection data-track="breadcrumb_click" data-track-label="{{ collection.title | escape }}">{{ collection.title }}</a>

      {% elsif first_collection %}
        {% render 'breadcrumb-parent', path: first_collection.url, separator: separator %}
        {{ separator }}
        <a href="{{ first_collection.url }}" data-breadcrumb-collection data-track="breadcrumb_click" data-track-label="{{ first_collection.title | escape }}">{{ first_collection.title }}</a>
      {% endif %}

      {{ separator }}
      <span class="breadcrumb-current">{{ product.title }}</span>

      {%- comment -%}
        Swap the collection crumb for the collection the shopper actually
        browsed (referrer, else last collection visited this session),
        if this product is in it; when moving product -> product (colour
        swatches) the previous trail is kept as-is.
      {%- endcomment -%}
      <script type="application/json" id="BreadcrumbProductCollections">
        {%- capture bc_json -%}{%- for c in product.collections -%}{{ c.handle | json }}:{"t":{{ c.title | json }},"u":{{ c.url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
        { {{ bc_json }} }
      </script>
      <script type="application/json" id="BreadcrumbMenuParents">
        { {{ bc_menu_json }} "_": 0 }
      </script>
      <template id="BreadcrumbSeparator">{{ separator }}</template>
      <script>
        (function () {
          try {
            var link = document.querySelector('[data-breadcrumb-collection]');
            var data = JSON.parse(document.getElementById('BreadcrumbProductCollections').textContent);
            if (!link || !data) return;
            // Trail = collection shown in the breadcrumb, remembered for this tab:
            // {h: handle, t: title, u: url}. Set on collection pages and here.
            var trail = null;
            try { trail = JSON.parse(sessionStorage.getItem('ts_bc_trail') || 'null'); } catch (e) {}
            var ref = document.referrer || '';
            var sameSite = ref.indexOf('//' + location.host + '/') !== -1;
            var refCol = sameSite ? ref.match(/\/collections\/([^\/?#]+)/) : null;
            var refHandle = refCol ? decodeURIComponent(refCol[1]) : null;
            var fromProduct = sameSite && !refCol && /\/products\//.test(ref);

            var chosen = null;
            if (refHandle && data[refHandle]) {
              // Came straight from a collection page
              chosen = { h: refHandle, t: data[refHandle].t, u: data[refHandle].u };
            } else if (fromProduct && trail && trail.u) {
              // Moved between products (colour swatch, recommendations):
              // keep the trail even if this colour isn't in that collection
              chosen = trail;
            } else if (trail && trail.h && data[trail.h]) {
              chosen = { h: trail.h, t: data[trail.h].t, u: data[trail.h].u };
            }

            if (!chosen) {
              // Keep the server fallback, and remember it for the next colour
              var sm = (link.getAttribute('href') || '').match(/\/collections\/([^\/?#]+)/);
              if (sm) {
                try { sessionStorage.setItem('ts_bc_trail', JSON.stringify({ h: decodeURIComponent(sm[1]), t: link.textContent.trim(), u: link.getAttribute('href') })); } catch (e) {}
              }
              return;
            }
            try { sessionStorage.setItem('ts_bc_trail', JSON.stringify(chosen)); } catch (e) {}
            var handle = chosen.h;
            data[handle] = { t: chosen.t, u: chosen.u };
            link.href = chosen.u;
            link.textContent = chosen.t;
            link.setAttribute('data-track-label', chosen.t);

            var parentEl = document.querySelector('[data-breadcrumb-parent]');
            if (!parentEl) return;
            var parents = {};
            try { parents = JSON.parse(document.getElementById('BreadcrumbMenuParents').textContent); } catch (e) {}
            var p = parents[data[handle].u];
            parentEl.innerHTML = '';
            if (!p) return;
            var sep = document.getElementById('BreadcrumbSeparator');
            if (sep) parentEl.appendChild(sep.content.cloneNode(true));
            var el;
            if (!p.u || p.u === '#') {
              el = document.createElement('span');
              el.className = 'breadcrumb-parent-label';
            } else {
              el = document.createElement('a');
              el.href = p.u;
              el.setAttribute('data-track', 'breadcrumb_click');
              el.setAttribute('data-track-label', p.t);
            }
            var title = String(p.t).toLowerCase().replace(/(^|\s)\S/g, function (c) { return c.toUpperCase(); });
            if (el.tagName === 'A') el.setAttribute('data-track-label', title);
            el.textContent = title;
            parentEl.appendChild(el);
          } catch (e) {}
        })();
      </script>

    {% elsif template contains 'collection' %}

      {% if template.name == 'list-collections' %}
        {{ separator }}
        <span class="breadcrumb-current">Collections</span>
      {% else %}
        {% render 'breadcrumb-parent', path: collection.url, separator: separator %}
        {{ separator }}
        <span class="breadcrumb-current">{{ collection.title }}</span>
        {% if collection.handle %}
          <script>try { sessionStorage.setItem('ts_bc_trail', JSON.stringify({ h: {{ collection.handle | json }}, t: {{ collection.title | json }}, u: {{ collection.url | json }} })); } catch (e) {}</script>
        {% endif %}
      {% endif %}
    
    {% elsif template contains 'page' %}

      {{ separator }}
      <span class="breadcrumb-current">{{ page.title }}</span>

    {% elsif template contains 'cart' %}

      {{ separator }}
      <span class="breadcrumb-current">Cart</span>


    {% elsif template contains 'blog' and template != 'article' %}

      {{ separator }}
      <span class="breadcrumb-current">Blogs</span>

    {% elsif template contains 'article' %}

      {{ separator }}
      <a href="{{ blog.url }}" data-track="breadcrumb_click" data-track-label="Blogs">Blogs</a>

      {{ separator }}
      <span class="breadcrumb-current">{{ article.title }}</span>

    {% endif %}

  </nav>
</div>

<style>
.breadcrumb {
  font-size: 14px;
  margin-bottom: 15px;
}
.breadcrumb a {
  text-decoration: none;
  color: inherit;
}
.breadcrumb-separator {
  margin: 0 5px;
}
.breadcrumb-current {
  font-weight: 500;
}
.breadcrumb [data-breadcrumb-parent] {
  display: contents;
}
.section-breadcrumb .breadcrumb .breadcrumb-parent-label {
  font-size: 14px;
  color: #8F8F93;
  font-weight: 500;
  line-height: 19px;
  text-transform: none;
  white-space: nowrap;
}
@media (max-width: 767px) {
  .section-breadcrumb .breadcrumb .breadcrumb-parent-label { font-size: 12px; line-height: 16px; }
}
</style>