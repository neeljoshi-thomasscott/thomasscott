
<div class="container">
  <nav class="breadcrumb" role="navigation" aria-label="breadcrumbs">
    
    <a href="{{ routes.root_url }}" data-track="breadcrumb_click" data-track-label="Home">Home</a>
    {% capture separator %}
      <span class="breadcrumb-separator">
        <svg width="6" height="6" viewBox="0 0 6 6" fill="none">
          <circle cx="3" cy="3" r="3" fill="#CDCDCF"/>
        </svg>
      </span>
    {% endcapture %}

    {% if template contains 'product' %}

      {%- comment -%}
        Fallback when we don't know where the shopper came from:
        first collection that isn't a sale/offer collection.
      {%- endcomment -%}
      {% assign first_collection = nil %}
      {% for c in product.collections %}
        {% unless c.handle contains 'sale' or c.handle contains 'black-friday' or c.handle contains 'offer' %}
          {% assign first_collection = c %}
          {% break %}
        {% endunless %}
      {% endfor %}
      {% if first_collection == nil %}
        {% assign first_collection = product.collections.first %}
      {% endif %}

      {% if collection %}
        {{ separator }}
        <a href="{{ collection.url }}" data-breadcrumb-collection data-track="breadcrumb_click" data-track-label="{{ collection.title | escape }}">{{ collection.title }}</a>

      {% elsif first_collection %}
        {{ separator }}
        <a href="{{ first_collection.url }}" data-breadcrumb-collection data-track="breadcrumb_click" data-track-label="{{ first_collection.title | escape }}">{{ first_collection.title }}</a>
      {% endif %}

      {{ separator }}
      <span class="breadcrumb-current">{{ product.title }}</span>

      {%- comment -%}
        Swap the collection crumb for the collection the shopper actually
        browsed (referrer, else last collection visited this session),
        but only if this product is in that collection.
      {%- endcomment -%}
      <script type="application/json" id="BreadcrumbProductCollections">
        {%- capture bc_json -%}{%- for c in product.collections -%}{{ c.handle | json }}:{"t":{{ c.title | json }},"u":{{ c.url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
        { {{ bc_json }} }
      </script>
      <script>
        (function () {
          try {
            var link = document.querySelector('[data-breadcrumb-collection]');
            var data = JSON.parse(document.getElementById('BreadcrumbProductCollections').textContent);
            if (!link || !data) return;
            var handle = null;
            var m = (document.referrer || '').match(/^https?:\/\/[^\/]+\/collections\/([^\/?#]+)/);
            if (m && document.referrer.indexOf(location.host) !== -1 && data[decodeURIComponent(m[1])]) {
              handle = decodeURIComponent(m[1]);
            } else {
              var last = null;
              try { last = sessionStorage.getItem('ts_last_collection'); } catch (e) {}
              if (last && data[last]) handle = last;
            }
            if (!handle) return;
            link.href = data[handle].u;
            link.textContent = data[handle].t;
            link.setAttribute('data-track-label', data[handle].t);
          } catch (e) {}
        })();
      </script>

    {% elsif template contains 'collection' %}

      {{ separator }}
      {% if template.name == 'list-collections' %}
        <span class="breadcrumb-current">Collections</span>
      {% else %}
        <span class="breadcrumb-current">{{ collection.title }}</span>
        {% if collection.handle %}
          <script>try { sessionStorage.setItem('ts_last_collection', {{ collection.handle | json }}); } catch (e) {}</script>
        {% endif %}
      {% endif %}
    
    {% elsif template contains 'page' %}

      {{ separator }}
      <span class="breadcrumb-current">{{ page.title }}</span>

    {% elsif template contains 'cart' %}

      {{ separator }}
      <span class="breadcrumb-current">Cart</span>


    {% elsif template contains 'blog' and template != 'article' %}

      {{ separator }}
      <span class="breadcrumb-current">Blogs</span>

    {% elsif template contains 'article' %}

      {{ separator }}
      <a href="{{ blog.url }}" data-track="breadcrumb_click" data-track-label="Blogs">Blogs</a>

      {{ separator }}
      <span class="breadcrumb-current">{{ article.title }}</span>

    {% endif %}

  </nav>
</div>

<style>
.breadcrumb {
  font-size: 14px;
  margin-bottom: 15px;
}
.breadcrumb a {
  text-decoration: none;
  color: inherit;
}
.breadcrumb-separator {
  margin: 0 5px;
}
.breadcrumb-current {
  font-weight: 500;
}
</style>