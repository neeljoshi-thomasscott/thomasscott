{%- doc -%}
  Renders the grid density controls.

  @param {string} viewport - The viewport to render the controls for, either 'mobile' or 'desktop'.

  @example
  {% render 'grid-density-controls', viewport: 'desktop' %}
{%- enddoc -%}

<div class="column-options-wrapper mobile">
  <fieldset class="column-options">
    <legend class="column-options__legend visually-hidden">
      {{ 'content.grid_view.grid_fieldset' | t }}
    </legend>

    {% if viewport == 'mobile' %}
      <label class="column-options__option mobile">
        <input
          type="radio"
          name="grid-mobile"
          value="mobile-single"
          class="column-options__option-input"
          aria-label="{{ 'content.grid_view.single_item' | t }}"
          on:change="results-list/updateLayout"
        >
        <span class="column-picker column-picker-mobile--single">
          {% comment %} <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 27 27" fill="none">
<rect x="0.61606" y="0.61606" width="25.7676" height="25.7672" stroke="#D3D3D3" stroke-width="1.23212"/>
</svg> {% endcomment %}
<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <rect x="0.5" y="0.5" width="17" height="17" stroke="currentColor"></rect>
        </svg>
          {% comment %} {{- 'icon-one-col-mobile.svg' | inline_asset_content -}}  {% endcomment %}
        </span>
      </label>

      <label class="column-options__option grid-active">
        <input
          type="radio"
          
          class="column-options__option-input"
          name="grid-mobile"
          value="default"
          checked
          aria-label="{{ 'content.grid_view.default_view' | t }}"
          data-grid-layout="mobile-option"
          on:change="results-list/updateLayout"  
        >
        <span class="column-picker column-picker-mobile--double">
          <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 27 27" fill="none">
<rect x="0.61606" y="0.61606" width="25.7676" height="25.7672" stroke="currentcolor" stroke-width="1.23212"/>
<path d="M13.5 26.9992V0.674805" stroke="currentcolor" stroke-width="1.23212"/>
</svg>
          {% comment %} {{- 'icon-grid-default.svg' | inline_asset_content -}} {% endcomment %}
        </span>
      </label>

    {% elsif viewport == 'desktop' %}
      <label class="column-options__option">
        <input
          type="radio"
          name="grid"
          value=""
          class="column-options__option-input"
          
          {% comment %} aria-label="{{ 'content.grid_view.default_view' | t }}" {% endcomment %}
          data-grid-layout="desktop-default-option"
          on:change="results-list/updateLayout"
          data-skip-node-update
        >
        <span class="column-picker column-picker--default">
          {% comment %} {{- 'icon-grid-default.svg' | inline_asset_content -}} {% endcomment %}
           <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 27 27" fill="none">
<rect x="0.61606" y="0.61606" width="25.7676" height="25.7672" stroke="#d3d3d3" stroke-width="1.23212"/>
<path d="M13.5 26.9992V0.674805" stroke="#d3d3d3" stroke-width="1.23212"/>
</svg>
        </span>
      </label>

      <label class="column-options__option">
        <input
          type="radio"
          name="grid"
          value="zoom-out"
          checked
          class="column-options__option-input"
           aria-label="{{ 'content.grid_view.default_view' | t }}"
          {% comment %} aria-label="{{ 'content.grid_view.zoom_out' | t }}" {% endcomment %}
          on:change="results-list/updateLayout"
          data-skip-node-update
        >
        <span class="column-picker column-picker--zoom-out">
          <svg xmlns="http://www.w3.org/2000/svg" width="27" height="27" viewBox="0 0 27 27" fill="none">
<rect x="0.61606" y="0.61606" width="25.7676" height="25.7672" stroke="#D3D3D3" stroke-width="1.23212"/>
<path d="M13.502 26.9992V0.674805" stroke="#D3D3D3" stroke-width="1.23212"/>
<path d="M26.6685 13.8437L0.34375 13.8438" stroke="#D3D3D3" stroke-width="1.23212"/>
</svg>
          {% comment %} {{- 'icon-grid-dense.svg' | inline_asset_content -}} {% endcomment %}
        </span>
      </label>
    {% endif %}
  </fieldset>
</div>
<style>
  
{% comment %} krishna css for plp {% endcomment %}
 .collection-wrapp .facets-controls-wrapper{display: flex !important;}

 {% comment %} @media screen and (max-width:549px) { {% endcomment %}

    {% comment %} .product-grid[product-grid-view="mobile-single"] {
      grid-template-columns: 1fr !important;
    } {% endcomment %}
    {% comment %} .product-grid[product-grid-view="mobile-single"] {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 12px;
  }

  /* Every 3rd item full width */
  .product-grid[product-grid-view="mobile-single"] > *:nth-child(3n) {
    grid-column: span 2;
  } {% endcomment %}
  @media screen and (max-width:549px) {

  .product-grid[product-grid-view="mobile-single"] {
    display: grid !important;
    grid-template-columns: repeat(1, 1fr) !important;
    gap: 12px;
  }
  

  /* 1st, 4th, 7th, 10th... product full width */
