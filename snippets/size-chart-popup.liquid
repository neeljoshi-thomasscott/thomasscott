<script>
(function() {
  var modal = document.getElementById('sizeChartModal-{{ product.id }}');
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }

  var BODY_CLASS = 'size-chart-open';

  document.addEventListener('click', function(e) {
    var openBtn = e.target.closest('[data-open-size][data-product-id="{{ product.id }}"]');
    if (!openBtn) return;
    e.preventDefault();
    e.stopPropagation();
    if (!modal) return;
    if (typeof modal.showModal === 'function') {
      if (!modal.open) modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
    document.body.classList.add(BODY_CLASS);
  });

  document.addEventListener('click', function(e) {
    var closeBtn = e.target.closest('.close-size');
    if (!closeBtn) return;
    var m = closeBtn.closest('.size-modal');
    if (!m) return;
    if (typeof m.close === 'function' && m.open) m.close();
    m.removeAttribute('open');
    document.body.classList.remove(BODY_CLASS);
  });

  if (modal) {
    modal.addEventListener('click', function(e) {
      var rect = modal.getBoundingClientRect();
      var outside = e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom;
      if (!outside) return;
      if (typeof modal.close === 'function' && modal.open) modal.close();
      modal.removeAttribute('open');
      document.body.classList.remove(BODY_CLASS);
    });

    modal.addEventListener('close', function() {
      document.body.classList.remove(BODY_CLASS);
      modal.removeAttribute('open');
    });
  }
})();
</script> 
