{%- doc -%}
  Size guide dialog for a product. Renders nothing when the product has no chart.
  Chart data: snippets/size-chart-data.liquid (generated from the size chart Excel — see tools/size-charts/build.js).
  Which chart a product gets: snippets/size-chart-key.liquid.
  Opened/closed by the [data-open-size] handler in assets/custom.js.

  @param {object} product - The product
{%- enddoc -%}
{%- capture size_chart -%}{%- render 'size-chart-content', product: product -%}{%- endcapture -%}

{%- if size_chart != blank -%}
  <dialog id="sizeChartModal-{{ product.id }}" class="size-modal">
    <div class="size-modal-content">
      <button type="button" class="close-size" aria-label="Close size guide">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <rect width="48" height="48" fill="#F4F4F4"/>
          <path d="M19.6797 29.6574L30.9944 18.3428M30.9944 29.6574L19.6797 18.3428" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      {{ size_chart }}

      <p class="size-guide-note">All measurements are of the garment. For best fit, compare with your body measurements.</p>
    </div>
  </dialog>
{%- endif -%}

{% stylesheet %}
  .size-modal {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    position: fixed;
    z-index: 99999;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    overflow: hidden;
    border: none;
    padding: 0;
  }

  .size-modal:not([open]) {
    display: none;
  }

  .size-modal[open] {
    display: block !important;
  }

  .size-modal-content {
    background: #fff;
    max-width: 680px;
    margin: 5% auto;
    padding: 28px 24px;
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }

  .close-size {
    position: absolute;
    right: 15px;
    top: 10px;
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    background: none;
    border: 0;
    padding: 0;
  }

  .size-guide-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .size-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 14px;
  }

  .size-table th,
  .size-table td {
    border: 1px solid #ddd;
    padding: 9px 12px;
    text-align: center;
  }

  .size-table thead th {
    background: #f5f5f5;
    font-weight: 600;
  }

  .size-guide-note {
    font-size: 12px;
    color: #888;
    margin-top: 12px;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .table-responsive img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .size-modal {
      transform: translateY(25%);
    }
  }
{% endstylesheet %}
