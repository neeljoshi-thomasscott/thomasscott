{% if section and section.location != blank %}{% comment %} 
{% liquid
  assign size_chart_metafield = product.metafields.custom.size_chart
  assign has_size_chart = false

  if size_chart_metafield != blank and size_chart_metafield.value != blank
    assign has_size_chart = true
  endif
%}

{% if has_size_chart %}
  <style>
    body.size-chart-open {
      overflow: hidden;
    }

    .size-modal {
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      position: fixed;
      z-index: 99999;
      inset: 0;
      margin: 0;
      padding: 20px;
      border: 0;
      background: rgba(0, 0, 0, 0.5);
      overflow-y: auto;
    }

    .size-modal::backdrop {
      background: rgba(0, 0, 0, 0.5);
    }

    .size-modal:not([open]) {
      display: none;
    }

    .size-modal[open] {
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }

    .size-modal-content {
      width: 100%;
      max-width: 680px;
      margin: 4vh auto;
      padding: 32px 24px 24px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
      background: #fff;
    }

    .close-size {
      position: absolute;
      right: 12px;
      top: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      padding: 0;
      border: 0;
      background: #f4f4f4;
      cursor: pointer;
    }

    .close-size svg {
      width: 24px;
      height: 24px;
      pointer-events: none;
    }

    .size-guide-title {
      padding-right: 48px;
      margin: 0 0 16px;
      font-size: 18px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .size-guide-wrapper {
      font-size: 14px;
      line-height: 1.5;
    }

    .size-guide-wrapper table {
      width: 100%;
      min-width: 520px;
      margin-bottom: 20px;
      border-collapse: collapse;
      font-size: 14px;
    }

    .size-guide-wrapper th,
    .size-guide-wrapper td {
      padding: 9px 12px;
      border: 1px solid #ddd;
      text-align: center;
    }

    .size-guide-wrapper thead th {
      background: #f5f5f5;
      font-weight: 600;
    }

    .size-guide-wrapper img {
      display: block;
      width: 100%;
      height: auto;
      margin-top: 16px;
    }

    .size-guide-data {
      overflow-x: auto;
    }

    .size-guide-note {
      margin: 12px 0 0;
      font-size: 12px;
      color: #888;
    }

    @media screen and (max-width: 749px) {
      .size-modal {
        padding: 12px;
      }

      .size-modal-content {
        margin: 2vh auto;
        padding: 28px 16px 20px;
        max-height: 94vh;
      }
    }
  </style>
{% liquid
  assign size_chart_metafield = product.metafields.custom.size_chart
  assign size_chart = size_chart_metafield.value
%}

{% if size_chart != blank %}
  <dialog id="sizeChartModal-{{ product.id }}" class="size-modal">
    <div class="size-modal-content">

      <button
        type="button"
        class="close-size"
        aria-label="Close size guide"
      >
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
          <rect width="48" height="48" fill="#F4F4F4"/>
          <path
            d="M19.6797 29.6574L30.9944 18.3428M30.9944 29.6574L19.6797 18.3428"
            stroke="black"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>

      {% comment %} {% if size_chart.title.value != blank %}
        <h2 class="size-guide-title">
          {{ size_chart.title.value }}
        </h2>
      {% endif %} {% endcomment %}

      {% if size_chart.chart_html.value != blank %}
        <div class="size-chart-html table-responsive">
          {{ size_chart.chart_html.value }}
        </div>
      {% endif %}

      {% if size_chart.image.value != blank %}
        <div class="size-chart-image">
          {{
            size_chart.image.value
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(max-width: 749px) 100vw, 680px',
              alt: size_chart.title.value
          }}
        </div>
      {% endif %}

      {% if size_chart.note.value != blank %}
        <p class="size-guide-note">
          {{ size_chart.note.value }}
        </p>
      {% endif %}

    </div>
  </dialog>
{% endif %}

  <script>
    (() => {
      const modalId = 'sizeChartModal-{{ product.id }}';
      const modal = document.getElementById(modalId);

      if (!modal || modal.dataset.initialized === 'true') return;
      modal.dataset.initialized = 'true';

      if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }

      const openModal = () => {
        if (typeof modal.showModal === 'function') {
          if (!modal.open) modal.showModal();
        } else {
          modal.setAttribute('open', '');
        }

        document.body.classList.add('size-chart-open');
      };

      const closeModal = () => {
        if (typeof modal.close === 'function' && modal.open) {
          modal.close();
        } else {
          modal.removeAttribute('open');
        }

        document.body.classList.remove('size-chart-open');
      };

      document.addEventListener('click', (event) => {
        const openButton = event.target.closest(
          '[data-open-size][data-product-id="{{ product.id }}"]'
        );

        if (!openButton) return;

        event.preventDefault();
        openModal();
      });

      modal.addEventListener('click', (event) => {
        if (event.target === modal || event.target.closest('[data-close-size]')) {
          closeModal();
        }
      });

      modal.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeModal();
      });

      modal.addEventListener('close', () => {
        document.body.classList.remove('size-chart-open');
      });
    })();
  </script>
{% endif %} {% endcomment %}



