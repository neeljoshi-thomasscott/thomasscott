cks":{}},"add-to-cart":{"type":"add-to-cart","static":true,"settings":{"style_class":"button"},"blocks":{}}},"block_order":[]},"text_aEtTtq":{"type":"text","name":"Product description","disabled":true,"settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"instaflow_edd_check_jCmCik":{"type":"shopify:\/\/apps\/instaflow\/blocks\/edd_check\/019a6de4-5f2a-7cbd-bf0c-286b66d60ce7","settings":{"sd_edd_label":"Estimated Delivery","sd_placeholder":"Enter Pincode","sd_button_text":"Check","sd_button_color":"#000000","sd_button_text_color":"#fff","sd_success_message_text":"","sd_success_message_text_color":"#000000","sd_success_message_select":"on","sd_failure_color":"#b91c1c","sd_failure_font_size":14,"sd_edd_response_text":"Express Delivery","sd_edd_response_select":"off","sd_express_color":"#6d28d9","sd_express_text_color":"#6d28d9","sd_standard_color":"#047857","sd_standard_text_color":"#047857","sd_ui_radius":8,"sd_ui_padding":12,"sd_ui_font_size":14,"sd_ui_margin_top":8,"sd_ui_margin_bottom":8,"sd_ui_margin_left":0,"sd_ui_margin_right":0}},"custom_liquid_gETNAa":{"type":"custom-liquid","name":"t:names.custom_liquid","disabled":true,"settings":{"custom_liquid":"<div class=\"estimated-delivery\">\n  <label>Estimated Delivery<\/label>\n\n  <div class=\"input-wrap\">\n    <input\n      type=\"text\"\n      name=\"pincode\"\n      maxlength=\"6\"\n      placeholder=\"Enter PIN code\"\n      inputmode=\"numeric\"\n      pattern=\"[0-9]*\"\n    \/>\n    <button type=\"button\" id=\"checkPincode\">\n      Check\n    <\/button>\n  <\/div>\n\n  <!-- Error -->\n  <p class=\"pincode-error\" style=\"display:none; color:red;\"><\/p>\n\n  <!-- Success -->\n  <div class=\"pincode-result\" style=\"display:none;\">\n    <p class=\"delivery-date\"><\/p>\n\n    <ul>\n      <li>✔ Delivery is available<\/li>\n      <li>✔ Cash on delivery available<\/li>\n      <li>✔ Return available<\/li>\n    <\/ul>\n  <\/div>\n<\/div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  const input = document.querySelector('input[name=\"pincode\"]');\n  const button = document.getElementById(\"checkPincode\");\n  const error = document.querySelector(\".pincode-error\");\n  const result = document.querySelector(\".pincode-result\");\n  const deliveryDate = document.querySelector(\".delivery-date\");\n\n  async function checkPincode() {\n\n    const pincode = input.value.trim();\n\n    \/\/ Reset\n    error.style.display = \"none\";\n    result.style.display = \"none\";\n\n    \/\/ Validation\n    if (!\/^[0-9]{6}$\/.test(pincode)) {\n      error.textContent = \"Please enter valid pincode\";\n      error.style.display = \"block\";\n      return;\n    }\n\n    button.disabled = true;\n    button.innerText = \"Checking...\";\n\n    try {\n\n      const response = await fetch(\n        \"https:\/\/ds.clickpost.in\/api\/v2\/predicted_sla_api\/?username=thomasscott&key=45248c6a-9ace-424a-8dab-25560b17dde4\",\n        {\n          method: \"POST\",\n          headers: {\n            \"Content-Type\": \"application\/json\"\n          },\n          body: JSON.stringify([\n            {\n              pickup_pincode: \"110001\",\n              drop_pincode: pincode\n            }\n          ])\n        }\n      );\n\n      const data = await response.json();\n\n      console.log(\"CLICKPOST RESPONSE:\", data);\n\n      const resultData = data?.result?.[0];\n\n      if (\n        resultData &&\n        resultData.predicted_sla_min\n      ) {\n\n        const minDays = resultData.predicted_sla_min;\n        const maxDays = resultData.predicted_sla_max;\n\n        let deliveryText = \"\";\n\n        if (minDays === maxDays) {\n          deliveryText =\n            minDays + \" Business Day\";\n        } else {\n          deliveryText =\n            minDays + \"-\" + maxDays + \" Business Days\";\n        }\n\n        deliveryDate.innerHTML =\n          \"Estimated Delivery: <strong>\" +\n          deliveryText +\n          \"<\/strong>\";\n\n        result.style.display = \"block\";\n\n      } else {\n\n        error.textContent =\n          \"Delivery not available at this pincode\";\n\n        error.style.display = \"block\";\n      }\n\n    } catch (err) {\n\n      console.error(\"API ERROR:\", err);\n\n      error.textContent =\n        \"Something went wrong. Please try again.\";\n\n      error.style.display = \"block\";\n\n    } finally {\n\n      button.disabled = false;\n      button.innerText = \"Check\";\n    }\n  }\n\n  \/\/ Allow only numbers\n  input.addEventListener(\"input\", function () {\n    input.value = input.value.replace(\/\\D\/g, \"\");\n  });\n\n  \/\/ Button click\n  button.addEventListener(\"click\", checkPincode);\n\n  \/\/ Enter key\n  input.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"Enter\") {\n      e.preventDefault();\n      checkPincode();\n    }\n  });\n\n});\n<\/script>"},"blocks":{}},"custom_liquid_xyg93Q":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"relish-ai-container\"><\/div>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const interval = setInterval(() => {\n    const chatbot = document.querySelector('#relish-ai-chat, iframe[src*=\"relish\"]');\n    const container = document.getElementById('relish-ai-container');\n\n    if (chatbot && container) {\n      container.appendChild(chatbot);\n      clearInterval(interval);\n    }\n  }, 500);\n});\n<\/script>"},"blocks":{}},"accordion_dBULia":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"