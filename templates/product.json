 blank %}\n          <div class=\"spec-row\">\n            <span class=\"spec-label\">Number of Items<\/span>\n            <span class=\"spec-value\">\n              {{ product.metafields.specs.number_of_items.value }}\n            <\/span>\n          <\/div>\n        {% endif %}\n\n        {% if product.metafields.specs.pattern.value != blank %}\n          <div class=\"spec-row\">\n            <span class=\"spec-label\">Pattern<\/span>\n            <span class=\"spec-value\">\n              {{ product.metafields.specs.pattern.value }}\n            <\/span>\n          <\/div>\n        {% endif %}\n\n      <\/div>\n\n    <\/div>\n\n  {% endif %}\n<\/div>\n\n<style>\n  .product-specs {\n    margin: 30px 0;\n    padding: 20px;\n    background: #f9f9f9;\n    border-radius: 8px;\n  }\n\n  .specs-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0 40px;\n  }\n\n  .spec-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 20px;\n    padding: 12px 0;\n    border-bottom: 1px solid #eee;\n  }\n\n  .spec-label {\n    font-weight: 500;\n    color: #333;\n  }\n\n  .spec-value {\n    color: #555;\n    text-align: right;\n  }\n\n  @media (max-width: 768px) {\n    .specs-grid {\n      grid-template-columns: 1fr;\n      gap: 0;\n    }\n  }\n<\/style>"},"blocks":{}}},"block_order":["custom_liquid_MNCNDH"]},"accordion_row_Jx6VkM":{"type":"_accordion-row","settings":{"heading":"Manufacture and packed by","open_by_default":false,"icon":"none","width":20},"blocks":{"text_xT3G6M":{"type":"text","settings":{"text":"<p>Country of origin: IndiaManufacture detail: Thomas Scott (India) Ltd,FCC- Solapur 413006; Email- contact@thomasscott.in, Contact - 022 66607965<br\/><br\/><\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","ba