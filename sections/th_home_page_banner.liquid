{% comment %} 
<section class="home-banner">
  {% for block in section.blocks %}
    <div class="item home-thumb {% if block.settings.heading!=blank  %} overlay-banner {% endif %}relative ">
     
      <div class="home-thumb relative">
      <a class="home-thumb-over" href="{{ block.settings.button_link }}">
        
      </a>
      <picture class="picture">
          {% if block.settings.mobile_image != blank %}
            <source media="(max-width:767px)" srcset="{{ block.settings.mobile_image | image_url: width: '500' }}">
          {% endif %}

          {% if block.settings.desktop_image != blank %}
            <source media="(min-width:768px)" srcset="{{ block.settings.desktop_image | image_url: width: '1440' }}">
          {% endif %}

          <img 
            data-src="{{ block.settings.desktop_image | image_url: width: '1440' }}" 
            alt="{{ block.settings.heading }}"
            width="1440"
            height="750"
            class="w-full lazyload"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
            decoding="async">
          
        </picture>
        {% if block.settings.heading!=blank %}
        <div class="banner-content">
          <div class="thomasxlheading">
            {{ block.settings.heading }}
          </div>

          <a href="{{ block.settings.button_link }}" class="thomas-wht-btn hovertime">
            {{ block.settings.button_text }}
          </a>
         
        </div>
      {% endif %}
      </div>
       
    </div>
  {% endfor %}
</section> {% endcomment %}

{%- liquid
  # Store time zone as +05:30, so schedules follow store time rather than each visitor's clock.
  assign tz = 'now' | date: '%z'
  assign tz_hours = tz | slice: 0, 3
  assign tz_minutes = tz | slice: 3, 2
  assign tz_offset = tz_hours | append: ':' | append: tz_minutes
-%}

<section class="home-banner" id="HomeBanner-{{ section.id }}">
  {% for block in section.blocks %}
    {%- liquid
      assign slide_start = ''
      assign start_date = block.settings.start_date | strip
      if start_date != blank
        assign start_time = block.settings.start_time | strip | default: '00:00'
        assign slide_start = start_date | append: 'T' | append: start_time | append: ':00' | append: tz_offset
      endif

      assign slide_end = ''
      assign end_date = block.settings.end_date | strip
      if end_date != blank
        assign end_time = block.settings.end_time | strip | default: '23:59'
        assign slide_end = end_date | append: 'T' | append: end_time | append: ':00' | append: tz_offset
      endif
    -%}
    {% assign desktop_image = block.settings.desktop_image %}
    {% assign mobile_image = block.settings.mobile_image %}
    {% assign fallback_image = desktop_image | default: mobile_image %}

    {% if fallback_image != blank %}
      <div
        class="item home-thumb relative{% if block.settings.heading != blank %} overlay-banner{% endif %}"
        {% if slide_start != blank %}data-show-from="{{ slide_start }}"{% endif %}
        {% if slide_end != blank %}data-show-until="{{ slide_end }}"{% endif %}
        {{ block.shopify_attributes }}
      >
        {% if block.settings.button_link != blank %}
          <a
            class="home-thumb-link"
            href="{{ block.settings.button_link }}"
            aria-label="{{ block.settings.heading | default: block.settings.button_text | escape }}"
          >
        {% endif %}

        <picture class="picture">
          {% if mobile_image != blank %}
            <source
              media="(max-width: 767px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 500 }} 500w,
                {{ mobile_image | image_url: width: 750 }} 750w
              "
              sizes="100vw"
            >
          {% endif %}

          {% if desktop_image != blank %}
            <source
              media="(min-width: 768px)"
              srcset="
                {{ desktop_image | image_url: width: 768 }} 768w,
                {{ desktop_image | image_url: width: 1200 }} 1200w,
                {{ desktop_image | image_url: width: 1440 }} 1440w,
                {{ desktop_image | image_url: width: 1920 }} 1920w
              "
              sizes="100vw"
            >
          {% endif %}

          <img
            src="{{ fallback_image | image_url: width: 1440 }}"
            width="{{ fallback_image.width }}"
            height="{{ fallback_image.height }}"
            alt="{{ fallback_image.alt | default: block.settings.heading | escape }}"
            class="w-full"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
            decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
          >
        </picture>

        {% if block.settings.heading != blank %}
          <div class="banner-content">
            <div class="thomasxlheading">
              {{ block.settings.heading }}
            </div>

            {% if block.settings.button_text != blank %}
              <span class="thomas-wht-btn hovertime">
                {{ block.settings.button_text }}
              </span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.button_link != blank %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</section>

{%- unless request.design_mode -%}
  {%- comment -%}
    Drop slides outside their schedule before custom.js starts the slick slider (it runs on
    DOM ready, after this inline script). The theme editor keeps every slide so they stay editable.
  {%- endcomment -%}
  <script>
    (function () {
      var banner = document.getElementById('HomeBanner-{{ section.id }}');
      if (!banner) return;
      var now = Date.now();
      banner.querySelectorAll('[data-show-from], [data-show-until]').forEach(function (slide) {
        var from = Date.parse(slide.getAttribute('data-show-from') || '');
        var until = Date.parse(slide.getAttribute('data-show-until') || '');
        if ((!isNaN(from) && now < from) || (!isNaN(until) && now >= until)) slide.remove();
      });
      if (!banner.children.length) banner.hidden = true;
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "Home Banner",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Business Essentials"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "VIEW COLLECTION"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "header",
          "content": "Schedule",
          "info": "Optional. Uses the store's time zone. Leave empty to always show. The theme editor always shows every slide; check the result in Preview."
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "Show from date",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "start_time",
          "label": "Show from time (24-hour)",
          "placeholder": "HH:MM",
          "info": "Defaults to 00:00."
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "Hide after date",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "Hide after time (24-hour)",
          "placeholder": "HH:MM",
          "info": "Defaults to 23:59."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Banner",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}