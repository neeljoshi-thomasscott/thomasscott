<section class="season-banner-slider">

  <div class="swiper seasonSwiper">
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide">
          <section class="season-banner relative">

            <picture class="picture">
              {% if block.settings.mobile_image %}
                <source media="(max-width:767px)" srcset="{{ block.settings.mobile_image | img_url: '600x' }}">
              {% endif %}

              {% if block.settings.desktop_image %}
                <source media="(min-width:768px)" srcset="{{ block.settings.desktop_image | img_url: '1600x' }}">
                <img 
                  src="{{ block.settings.desktop_image | img_url: '1600x' }}" 
                  class="w-full"
                  alt="{% if block.settings.desktop_image.alt %}{{ block.settings.desktop_image.alt }}{% else %}{{ block.settings.heading }}{% endif %}"
                  width="auto" height="auto"
                >
              {% endif %}
            </picture>

            <div class="banner-content">
              <div class="thomasxlheading">
                {{ block.settings.heading }}
              </div>

              <a href="{{ block.settings.link }}" class="thomas-btn hovertime">
                {{ block.settings.button_text }}
              </a>
            </div>

          </section>
        </div>
      {% endfor %}

    </div>

    <!-- Optional arrows -->
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>

  </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  new Swiper(".seasonSwiper", {
    loop: true,
    slidesPerView: 1,
    spaceBetween: 20,

    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },

    autoplay: {
      delay: 3000,
    }
  });
});
</script>
{% schema %}
{
  "name": "Season Banner Slider",
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Business Essentials"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "View All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Season Banner Slider",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}