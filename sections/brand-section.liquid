<section class="section-{{ section.id }}">
    <h1>{{ section.settings.title }}</h1>

    <p class="top-desc">
        {{ section.settings.description }}
    </p>

    <div class="content-wrapper">

        <div class="image-container">

            {% if section.settings.desktop_image != blank %}
                <img class="desktop-img" 
                     src="{{ section.settings.desktop_image | image_url: width: 1500 }}">
            {% endif %}

            {% if section.settings.mobile_image != blank %}
                <img class="mobile-img"
                     src="{{ section.settings.mobile_image | image_url: width: 1000 }}">
            {% else %}
                <!-- fallback: use desktop image -->
                {% if section.settings.desktop_image != blank %}
                    <img class="mobile-img"
                         src="{{ section.settings.desktop_image | image_url: width: 1000 }}">
                {% endif %}
            {% endif %}

        </div>

        <div class="text-card">
            <h2>{{ section.settings.card_title }}</h2>
            <p>{{ section.settings.card_text1 }}</p>
            <p>{{ section.settings.card_text2 }}</p>
        </div>

    </div>
</section>

{% schema %}
{
  "name": "Brand Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "ALL DAY, ALL SEASONS, ALL SIZES."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Top Description"
    },

    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },

    {
      "type": "text",
      "id": "card_title",
      "label": "Card Title",
      "default": "FASHION-FORWARD ACROSS TWO GENERATIONS"
    },
    {
      "type": "textarea",
      "id": "card_text1",
      "label": "Card Paragraph 1"
    },
    {
      "type": "textarea",
      "id": "card_text2",
      "label": "Card Paragraph 2"
    }
  ],
  "presets": [
    {
      "name": "Brand Section"
    }
  ]
}
{% endschema %}


<style>
.section-{{ section.id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    text-align: center;
}

.section-{{ section.id }} h1 {
    font-size: 28px;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.section-{{ section.id }} .top-desc {
    font-size: 14px;
    color: #777;
    max-width: 800px;
    margin: 0 auto 50px;
    line-height: 1.6;
}

.section-{{ section.id }} .content-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.section-{{ section.id }} .image-container {
    width: 100%;
    height: 400px;
    overflow: hidden;
}

.section-{{ section.id }} .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* Desktop image */
.section-{{ section.id }} .desktop-img {
    display: block;
}

/* Mobile image hidden by default */
.section-{{ section.id }} .mobile-img {
    display: none;
}

.section-{{ section.id }} .text-card {
    position: absolute;
    right: 40px;
    background: rgba(255,255,255,0.95);
    padding: 30px;
    max-width: 400px;
    text-align: left;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.section-{{ section.id }} .text-card h2 {
    font-size: 18px;
    margin-bottom: 15px;
}

.section-{{ section.id }} .text-card p {
    font-size: 14px;
    color: #666;
    margin-bottom: 10px;
}

/* 📱 Mobile */
@media (max-width: 768px) {

    /* swap images */
    .section-{{ section.id }} .desktop-img {
        display: none;
    }

    .section-{{ section.id }} .mobile-img {
        display: block;
    }

    .section-{{ section.id }} .content-wrapper {
        flex-direction: column;
    }

    .section-{{ section.id }} .text-card {
        position: relative;
        right: auto;
        margin-top: -60px;
        width: 90%;
    }

    .section-{{ section.id }} .image-container {
        height: 300px;
    }
}
</style>