<div class="urgency-sale-timer section-{{ section.id }}{% if section.settings.make_sticky %} urgency-sale-timer--sticky{% endif %}">
  <div class="urgency-sale-timer__inner">
    {% if section.settings.heading != blank %}
      <p class="urgency-sale-timer__heading">{{ section.settings.heading }}</p>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="urgency-sale-timer__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if settings.sale_timer_end_date != blank %}
      {% render 'urgency-timer', hide_closest: '.shopify-section' %}
    {% else %}
      <p class="urgency-sale-timer__placeholder">Set a sale end date in Theme settings → Urgency sale timer to start the countdown.</p>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="urgency-sale-timer__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Urgency Sale Timer",
  "settings": [
    {
      "type": "paragraph",
      "content": "The sale end time, expiry action and unit labels are shared with the announcement bar and cart drawer. Edit them in Theme settings → Urgency sale timer."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hurry! Sale ends in:"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the sale"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "make_sticky",
      "label": "Stick to top of page",
      "default": false,
      "info": "Useful when this section is added to the header section group as an urgency bar."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_background_color",
      "label": "Timer box background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Timer box text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Urgency Sale Timer"
    }
  ]
}
{% endschema %}

<style>
.section-{{ section.id }} {
  --urgency-bg: {{ section.settings.background_color }};
  --urgency-text: {{ section.settings.text_color }};
  --urgency-accent-bg: {{ section.settings.accent_background_color }};
  --urgency-accent-text: {{ section.settings.accent_text_color }};
  --urgency-button-bg: {{ section.settings.button_background_color }};
  --urgency-button-text: {{ section.settings.button_text_color }};

  display: block;
  background: var(--urgency-bg);
  color: var(--urgency-text);
  padding: 24px 20px;
  font-family: var(--font-paragraph--family, inherit);
}

.section-{{ section.id }}.urgency-sale-timer--sticky {
  position: sticky;
  top: 0;
  z-index: 10;
}

.section-{{ section.id }} .urgency-sale-timer__inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: {% if section.settings.alignment == 'left' %}flex-start{% elsif section.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};
  text-align: {{ section.settings.alignment }};
  gap: 12px 24px;
}

.section-{{ section.id }} .urgency-sale-timer__heading {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
  letter-spacing: 0.3px;
}

.section-{{ section.id }} .urgency-sale-timer__subheading {
  font-size: 14px;
  margin: 0;
  opacity: 0.85;
}

.section-{{ section.id }} .urgency-sale-timer__placeholder {
  font-size: 13px;
  margin: 0;
  opacity: 0.7;
  font-style: italic;
}

.section-{{ section.id }} .urgency-timer__display {
  display: flex;
  gap: 10px;
}

.section-{{ section.id }} .urgency-timer__unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--urgency-accent-bg);
  color: var(--urgency-accent-text);
  border-radius: 6px;
  min-width: 56px;
  padding: 6px 8px;
}

.section-{{ section.id }} .urgency-timer__value {
  font-size: 22px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.section-{{ section.id }} .urgency-timer__label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  opacity: 0.7;
}

.section-{{ section.id }} .urgency-timer__message {
  font-size: 15px;
  font-weight: 600;
  margin: 0;
}

.section-{{ section.id }} .urgency-sale-timer__button {
  display: inline-block;
  background: var(--urgency-button-bg);
  color: var(--urgency-button-text);
  padding: 10px 20px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

@media (max-width: 749px) {
  .section-{{ section.id }} .urgency-sale-timer__inner {
    justify-content: center;
    text-align: center;
  }

  .section-{{ section.id }} .urgency-timer__unit {
    min-width: 48px;
  }

  .section-{{ section.id }} .urgency-timer__value {
    font-size: 18px;
  }
}
</style>
