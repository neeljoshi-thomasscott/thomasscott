<section class="watch-buy-sec">
  <div class="container">
    <!-- Heading -->
    <div class="top-heading top-btn-heading relative">
      <h4 class="thomasxlheading">{{ section.settings.heading }}</h4>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="thomas-btn thomas-black-btn hovertime">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="slider-rl">
      <div class="watch-buy-slider">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}

          <div class="item" {{ block.shopify_attributes }}>
            <div class="watch-buy-card relative hovertime">
              <!-- Media -->
              <div class="watch-buy-thumb">
                {% if block.settings.media_type == 'image' %}
                  {% if block.settings.main_image %}
                    <img
                      data-src="{{ block.settings.main_image | image_url: width: 400 }}"
                      alt="{{ block.settings.main_image.alt | escape }}"
                      loading="lazy"
                      width="auto"
                      height="auto"
                      class="lazyload"
                    >
                  {% endif %}

                {% comment %} {% elsif block.settings.media_type == 'video' %}
                  {% if block.settings.main_video %}
                    {{
                      block.settings.main_video
                      | video_tag:
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        class: 'watch-buy-video'
                    }}
                  {% endif %}
                {% endif %} {% endcomment %}
                 {% elsif block.settings.media_type == 'video' %}
  {% if block.settings.main_video %}
   <div class="video-wrapper">

  <img
    class="video-poster lazyload"
    data-src="{{ block.settings.main_video.preview_image | image_url: width: 400 }}"
    alt="{{ block.settings.main_video.preview_image.alt | escape }}"
    width="auto"
    height="auto"
    loading="lazy"
  >

  {%- comment -%}
    Lazy video: no src until the card scrolls into view (see script below).
    Pick small MP4 renditions — cards are ~400px wide, so 1080p is wasted.
    src_sd = largest MP4 with long side <= 480 (phones), src_hd = <= 720 (desktop).
  {%- endcomment -%}
  {%- liquid
    assign vid = block.settings.main_video
    assign src_sd = ''
    assign src_hd = ''
    assign sd_long = 0
    assign hd_long = 0
    assign src_min = ''
    assign min_long = 100000
    for s in vid.sources
      if s.format == 'mp4'
        assign long = s.width | at_least: s.height
        if long <= 480 and long > sd_long
          assign src_sd = s.url
          assign sd_long = long
        endif
        if long <= 720 and long > hd_long
          assign src_hd = s.url
          assign hd_long = long
        endif
        if long < min_long
          assign src_min = s.url
          assign min_long = long
        endif
      endif
    endfor
    if src_hd == ''
      assign src_hd = src_min
    endif
    if src_sd == ''
      assign src_sd = src_hd
    endif
  -%}
  <video
    class="watch-buy-video"
    muted
    loop
    playsinline
    preload="none"
    style="aspect-ratio: {{ vid.aspect_ratio | default: 0.5625 }};"
    data-src-mobile="{{ src_sd }}"
    data-src-desktop="{{ src_hd }}"
  ></video>

</div>
  {% endif %}
{% endif %}
              </div>

              {% comment %}
                <!-- Product Card -->
                {% if product %}
                  {% render 'th-shop-look-card',
                    product: product,
                    class: 'product-mini-card'
                  %}
                {% endif %}
              {% endcomment %}
              {% comment %}
                <div class="watch-buy-products-slider">
                  {% for i in (1..6) %}
                    {% assign product_key = 'product_' | append: i %}
                    {% assign product = block.settings[product_key] %}

                    {% if product %}
                      {% render 'th-shop-look-card', product: product, class: 'product-mini-card' %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endcomment %}

              {% comment %} Check if at least one product exists {% endcomment %}
              {% assign has_products = false %}
              {% for i in (1..6) %}
                {% assign product_key = 'product_' | append: i %}
                {% assign check_product = block.settings[product_key] %}
                {% if check_product != blank and check_product.id != blank %}
                  {% assign has_products = true %}
                {% endif %}
              {% endfor %}

              {% if has_products %}
                <div class="watch-buy-products-slider">
                  {% for i in (1..6) %}
                    {% assign product_key = 'product_' | append: i %}
                    {% assign product = block.settings[product_key] %}
                    {% if product != blank and product.id != blank %}
                      {% render 'th-shop-look-card', product: product, class: 'product-mini-card' %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>

.video-wrapper{
  position:relative;
}

.video-poster{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  z-index:4; /* sits over the empty video until it starts playing, then removed */
}

.watch-buy-video{
  position:relative;
  z-index:3;
}




  .watch-buy-slider .slick-track{display:flex;}
  .watch-buy-slider .item{height:inherit;}
  .watch-buy-slider .watch-buy-card, .watch-buy-slider .watch-buy-thumb{height:100%;}
  .watch-buy-slider .watch-buy-thumb {
    position: relative;
    overflow: hidden;
  }

  .watch-buy-slider .watch-buy-thumb img,
  .watch-buy-slider .watch-buy-thumb video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .watch-buy-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Add these styles */
  .watch-buy-card .watch-buy-products-slider {
    pointer-events: none;           /* Important: default state */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain; /* Prevents parent scroll */
  }

  .watch-buy-card:hover .watch-buy-products-slider {
    pointer-events: auto;           /* Enable only on hover */
    z-index: 10;
  }

  /* Better scroll experience */
  .watch-buy-card .watch-buy-products-slider::-webkit-scrollbar {
    display: none;
  }

  /* Prevent card from moving while scrolling inner */
  .watch-buy-card .watch-buy-products-slider {
    touch-action: pan-y pan-x;     /* Allow horizontal scroll */
  }
</style>
<script>
// Load each video only when its card is near the viewport, pause it when it leaves.
document.addEventListener('DOMContentLoaded', () => {
  const videos = document.querySelectorAll('.watch-buy-video[data-src-desktop]');
  if (!videos.length) return;
  const isMobile = window.matchMedia('(max-width: 767px)').matches;

  const start = (video) => {
    if (!video.src) {
      video.src = isMobile ? video.dataset.srcMobile : video.dataset.srcDesktop;
    }
    const p = video.play();
    if (p && p.catch) p.catch(() => {});
  };

  videos.forEach(video => {
    video.addEventListener('playing', () => {
      const poster = video.parentElement.querySelector('.video-poster');
      if (poster) poster.remove();
    }, { once: true });
  });

  if (!('IntersectionObserver' in window)) {
    videos.forEach(start);
    return;
  }

  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) start(entry.target);
      else if (entry.target.src) entry.target.pause();
    });
  }, { rootMargin: '200px 0px' });

  videos.forEach(video => io.observe(video));
});
</script>
<script>
   
  document.addEventListener('DOMContentLoaded', function() {
    function initWatchBuySliders() {
      const innerSliders = document.querySelectorAll('.watch-buy-products-slider');

      innerSliders.forEach(slider => {
        // Stop Slick from stealing the drag
        slider.addEventListener('mousedown', function(e) {
          e.stopImmediatePropagation();
        }, true);

        slider.addEventListener('touchstart', function(e) {
          e.stopImmediatePropagation();
        }, true);

        // Optional: Also stop wheel events from bubbling
        slider.addEventListener('wheel', function(e) {
          if (this.scrollWidth > this.clientWidth) {
            e.stopPropagation();
          }
        }, { passive: true });
      });
    }

    // Initialize
    initWatchBuySliders();

    // Re-initialize after Slick re-renders (important for dynamic sliders)
    if (typeof $ !== 'undefined' && $.fn.slick) {
      $('.watch-buy-slider').on('afterChange', function() {
        setTimeout(initWatchBuySliders, 100);
      });
    }
  });
  </script>


