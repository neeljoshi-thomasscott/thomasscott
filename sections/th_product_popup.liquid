<section class="watch-buy-sec">
  <div class="container">
    <!-- Heading -->
    <div class="top-heading top-btn-heading relative">
      <h4 class="thomasxlheading">{{ section.settings.heading }}</h4>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="thomas-btn thomas-black-btn hovertime">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>

    <div class="slider-rl">
      <div class="watch-buy-slider">
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}

          <div class="item" {{ block.shopify_attributes }}>
            <div class="watch-buy-card relative hovertime">
              <!-- Media -->
              <div class="watch-buy-thumb">
                {% if block.settings.media_type == 'image' %}
                  {% if block.settings.main_image %}
                    <img
                      data-src="{{ block.settings.main_image | image_url: width: 400 }}"
                      alt="{{ block.settings.main_image.alt | escape }}"
                      loading="lazy"
                      width="auto"
                      height="auto"
                      class="lazyload"
                    >
                  {% endif %}

                {% comment %} {% elsif block.settings.media_type == 'video' %}
                  {% if block.settings.main_video %}
                    {{
                      block.settings.main_video
                      | video_tag:
                        autoplay: true,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        class: 'watch-buy-video'
                    }}
                  {% endif %}
                {% endif %} {% endcomment %}
                 {% elsif block.settings.media_type == 'video' %}
  {% if block.settings.main_video %}
   <div class="video-wrapper">

  <img
    class="video-poster lazyload"
    data-src="{{ block.settings.main_video.preview_image | image_url: width: 400 }}"
    alt="{{ block.settings.main_video.preview_image.alt | escape }}"
    width="auto"
    height="auto"
    loading="lazy"
  >

  {{
    block.settings.main_video
    | video_tag:
      autoplay: true,
      loop: true,
      muted: true,
      controls: false,
      playsinline: true,
      class: 'watch-buy-video'
  }}

</div>
  {% endif %}
{% endif %}
              </div>

              {% comment %}
                <!-- Product Card -->
                {% if product %}
                  {% render 'th-shop-look-card',
                    product: product,
                    class: 'product-mini-card'
                  %}
                {% endif %}
              {% endcomment %}
              {% comment %}
                <div class="watch-buy-products-slider">
                  {% for i in (1..6) %}
                    {% assign product_key = 'product_' | append: i %}
                    {% assign product = block.settings[product_key] %}

                    {% if product %}
                      {% render 'th-shop-look-card', product: product, class: 'product-mini-card' %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endcomment %}

              {% comment %} Check if at least one product exists {% endcomment %}
              {% assign has_products = false %}
              {% for i in (1..6) %}
                {% assign product_key = 'product_' | append: i %}
                {% assign check_product = block.settings[product_key] %}
                {% if check_product != blank and check_product.id != blank %}
                  {% assign has_products = true %}
                {% endif %}
              {% endfor %}

              {% if has_products %}
                <div class="watch-buy-products-slider">
                  {% for i in (1..6) %}
                    {% assign product_key = 'product_' | append: i %}
                    {% assign product = block.settings[product_key] %}
                    {% if product != blank and product.id != blank %}
                      {% render 'th-shop-look-card', product: product, class: 'product-mini-card' %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>

.video-wrapper{
  position:relative;
}

.video-poster{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  z-index:2;
}

.watch-buy-video{
  position:relative;
  z-index:3;
}




  .watch-buy-slider .slick-track{display:flex;}
  .watch-buy-slider .item{height:inherit;}
  .watch-buy-slider .watch-buy-card, .watch-buy-slider .watch-buy-thumb{height:100%;}
  .watch-buy-slider .watch-buy-thumb {
    position: relative;
    overflow: hidden;
  }

  .watch-buy-slider .watch-buy-thumb img,
  .watch-buy-slider .watch-buy-thumb video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .watch-buy-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Add these styles */
  .watch-buy-card .watch-buy-products-slider {
    pointer-events: none;           /* Important: default state */
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain; /* Prevents parent scroll */
  }

  .watch-buy-card:hover .watch-buy-products-slider {
    pointer-events: auto;           /* Enable only on hover */
    z-index: 10;
  }

  /* Better scroll experience */
  .watch-buy-card .watch-buy-products-slider::-webkit-scrollbar {
    display: none;
  }

  /* Prevent card from moving while scrolling inner */
  .watch-buy-card .watch-buy-products-slider {
    touch-action: pan-y pan-x;     /* Allow horizontal scroll */
  }
</style>
<script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.watch-buy-video').forEach(video => {
    video.addEventListener('playing', () => {
      const poster = video.parentElement.querySelector('.video-poster');
      if (poster) poster.remove();
    });
  });
});
</script>
<script>
   
  document.addEventListener('DOMContentLoaded', function() {
    function initWatchBuySliders() {
      const innerSliders = document.querySelectorAll('.watch-buy-products-slider');

      innerSliders.forEach(slider => {
        // Stop Slick from stealing the drag
        slider.addEventListener('mousedown', function(e) {
          e.stopImmediatePropagation();
        }, true);

        slider.addEventListener('touchstart', function(e) {
          e.stopImmediatePropagation();
        }, true);

        // Optional: Also stop wheel events from bubbling
        slider.addEventListener('wheel', function(e) {
          if (this.scrollWidth > this.clientWidth) {
            e.stopPropagation();
          }
        }, { passive: true });
      });
    }

    // Initialize
    initWatchBuySliders();

    // Re-initialize after Slick re-renders (important for dynamic sliders)
    if (typeof $ !== 'undefined' && $.fn.slick) {
      $('.watch-buy-slider').on('afterChange', function() {
        setTimeout(initWatchBuySliders, 100);
      });
    }
  });
  </script>


