

<section class="store-locator-sec">
  <div class="container">
    <div class="store-locator-list">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="store-card" {{ block.shopify_attributes }}>
            <header class="thomasmdheading">
              {% if block.settings.store_link != blank %}
                <a href="{{ block.settings.store_link }}">
                  {{ block.settings.heading | escape }}
                </a>
              {% else %}
                {{ block.settings.heading | escape }}
              {% endif %}
            </header>

            {% if block.settings.address != blank %}
              <p>{{ block.settings.address | escape }}</p>
            {% endif %}

            <div class="store-card-info">
              <div class="store-card-left">
                <div class="thomasxsheading">
                  Contact details
                </div>

                {% if block.settings.phone != blank %}
                  <div class="store-call">
                    <span class="store-call-icon">
                      {% if section.settings.phone_icon != blank %}
                        <img
                          width="24"
                          height="24"
                          class="w-full lazyload"
                          src="{{ section.settings.phone_icon | image_url }}"
                          alt="Phone icon"
                        >
                      {% endif %}
                    </span>
                    <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">
                      {{ block.settings.phone }}
                    </a>
                  </div>
                {% endif %}
              </div>

              <div class="store-card-right">
                <div class="thomasxsheading">
                 Timings
                </div>

                {% if block.settings.hours != blank %}
                  <div class="store-call">
                    <span class="store-call-icon">
                      {% if section.settings.time_icon != blank %}
                        <img
                          width="24"
                          height="24"
                          class="w-full lazyload"
                          src="{{ section.settings.time_icon | image_url }}"
                          alt="Time icon"
                        >
                      {% endif %}
                    </span>
                    <p>{{ block.settings.hours | escape }}</p>
                  </div>
                {% endif %}
              </div>
            </div>

            {% if block.settings.directions_url != blank %}
              <a
                href="{{ block.settings.directions_url }}"
                class="thomas-btn thomas-black-btn hovertime store-btn"
                target="_blank"
                rel="noopener noreferrer"
              >
                Get directions
              </a>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <p>No stores added yet.</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .store-locator-sec {
    padding: 40px 0;
  }

  .store-locator-list {
    display: grid;
    gap: 24px;
  }

  .store-card {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 24px;
  }

  .store-card-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .store-call {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .store-call-icon {
    flex: 0 0 auto;
  }
{% endstylesheet %}

