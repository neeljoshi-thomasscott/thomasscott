{% assign products = collection.products | slice: 0, 10 %}

<section class="customers-bought">
		<div class="container">
      {% content_for 'blocks' %}
      
			<div class="customers-main">
				
        <div class="customers-list" data-bundle>
          
        </div>
        <button type="button" class="thomas-wht-btn hovertime bundle-add-btn" tabindex="0">Buy All 3 at just ₹2999</button>
			</div>
		</div>
	</section>
<script>
  window.BUNDLE_COLLECTIONS = [
    {% for collection in product.collections %}
      "{{ collection.url | split: '/' | last }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {

  function getRandomItems(arr, count) {
    const shuffled = [...arr].sort(() => 0.5 - Math.random());
    return shuffled.slice(0, count);
  }

  async function fetchCollection(handle) {
    const res = await fetch(`/collections/${handle}?section_id=bundle_product`);
    const html = await res.text();

    const doc = new DOMParser().parseFromString(html, "text/html");
    return [...doc.querySelectorAll(".customers-card")];
  }

  async function buildBundle() {

    const container = document.querySelector("[data-bundle]");
    const button = document.querySelector(".bundle-add-btn");

    // ✅ Loading state
    container.innerHTML = `<div class="bundle-loading">Loading bundle...</div>`;
    button.disabled = true;
    button.innerText = "Loading...";

    const selectedCollections = getRandomItems(window.BUNDLE_COLLECTIONS, 5);
    // 👆 pick more to avoid empty/duplicates fallback

    let finalProducts = [];
    let usedProductIds = new Set();

    for (let handle of selectedCollections) {

      if (finalProducts.length >= 3) break;

      const products = await fetchCollection(handle);

      for (let p of products) {
        const id = p.dataset.productId;

        if (!usedProductIds.has(id)) {
          usedProductIds.add(id);
          finalProducts.push(p);
          break;
        }
      }
    }

    // ⚠️ fallback if still < 3
    if (finalProducts.length < 3) {
      console.warn("Not enough unique products, retrying...");
      return buildBundle();
    }

    renderBundle(finalProducts);
  }

  function renderBundle(products) {
    const container = document.querySelector("[data-bundle]");
    container.innerHTML = "";

    products.forEach((product, index) => {
      container.appendChild(product);

      if (index < products.length - 1) {
        const plus = document.createElement("div");
        plus.className = "plus-mid";
        plus.innerHTML = "+";
        container.appendChild(plus);
      }
    });

    updatePrice();
  }

  function updatePrice() {
    let total = 0;

    document.querySelectorAll(".customers-card").forEach(card => {
      total += parseInt(card.dataset.price);
    });

    const button = document.querySelector(".bundle-add-btn");
    button.innerHTML = `Buy All 3 at ${Shopify.formatMoney(total)}`;
    button.disabled = false;
  }

  async function addBundleToCart() {
    const items = [];

    document.querySelectorAll(".customers-card").forEach(card => {
      items.push({
        id: card.dataset.variantId,
        quantity: 1
      });
    });

    const btn = document.querySelector(".bundle-add-btn");
    btn.disabled = true;
    btn.innerText = "Adding...";

    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items })
    });

    btn.innerText = "Added into Cart";

    // Horizon compatible triggers
    document.dispatchEvent(new CustomEvent("cart:refresh"));
    document.dispatchEvent(new CustomEvent("cart:open"));
  }

  document.addEventListener("click", e => {
    if (e.target.closest(".bundle-add-btn")) {
      addBundleToCart();
    }
  });

  buildBundle();
});
</script>
