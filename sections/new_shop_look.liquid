{% comment %} Shop The Look - FIXED Clean Card Popup (No Full Page) {% endcomment %}

<section class="shop-look">
  <div class="container">
    <div class="top-heading relative">
      <div class="thomasxlheading">{{ section.settings.heading | default: "Shop the look" }}</div>
    </div>

    <div class="shop-look-banner">
      <picture>
        <source media="(max-width:767px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
        <source media="(min-width:768px)" srcset="{{ section.settings.desktop_image | image_url: width: 1920 }}">
        <img src="{{ section.settings.desktop_image | image_url: width: 1920 }}" alt="Shop the look" width="1920" height="750" class="w-full lazyload">
      </picture>

      <!-- Hotspots -->
      <div class="shop-look-points">
        {% for block in section.blocks %}
          {% assign prod = block.settings.product %}
          <div class="shop-look-point" 
               data-product-id="{{ prod.id }}"
               style="left: {{ block.settings.x_position }}%; top: {{ block.settings.y_position }}%;">
            <svg class="look-dot" width="6" height="6" viewBox="0 0 6 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="3" cy="3" r="3" fill="#1E1E1E"/>
            </svg>
          </div>
        {% endfor %}
      </div>

      <!-- Desktop Popup -->
      <div class="shop-look-modal" id="shop-look-modal">
        <div class="modal-content">
          <button class="modal-close">×</button>
          <div id="modal-product-wrapper" class="modal-product-wrapper"></div>
        </div>
      </div>
    </div>

    <!-- Mobile Swiper -->
    <div class="mobile-shop-look-swiper">
      <div class="swiper shop-look-mobile-swiper" id="mobile-swiper">
        <div class="swiper-wrapper" id="mobile-swiper-wrapper"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop Banner" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Banner" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Select Product" },
        { "type": "range", "id": "x_position", "label": "X Position (%)", "min": 0, "max": 100, "step": 1, "default": 35 },
        { "type": "range", "id": "y_position", "label": "Y Position (%)", "min": 0, "max": 100, "step": 1, "default": 45 }
      ]
    }
  ],
  "presets": [{ "name": "Shop The Look" }]
}
{% endschema %}

<style>
.shop-look-banner { position: relative; }
.shop-look-points { position: absolute; inset: 0; pointer-events: none; }
.shop-look-point { 
  position: absolute; 
  width: 34px; 
  height: 34px; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  cursor: pointer; 
  pointer-events: all;
}
.look-dot { transition: transform 0.3s; }
.shop-look-point:hover .look-dot { transform: scale(1.4); }

.shop-look-modal {
  display: none;
  position: fixed; 
  inset: 0;
  background: rgba(0,0,0,0.75);
  z-index: 9999;
  align-items: center; 
  justify-content: center;
}
.modal-content {
  background: #fff;
  max-width: 380px;
  width: 92%;
  border-radius: 12px;
  position: relative;
  padding: 20px;
}
.modal-close {
  position: absolute; 
  top: 12px; 
  right: 16px;
  font-size: 30px; 
  background: none; 
  border: none; 
  cursor: pointer;
}

.mobile-shop-look-swiper { margin-top: 20px; display: none; }
@media (max-width: 767px) { 
  .mobile-shop-look-swiper { display: block; } 
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('shop-look-modal');
  const wrapper = document.getElementById('modal-product-wrapper');

  document.querySelectorAll('.shop-look-point').forEach(point => {
    point.addEventListener('click', function() {
      const productId = this.dataset.productId;
      if (!productId) return;

      // Direct render using product id (most reliable)
      fetch(`/products/${productId}?view=product-card`)
        .then(res => res.text())
        .then(html => {
          wrapper.innerHTML = html;
          modal.style.display = 'flex';
        })
        .catch(err => {
          console.error("Popup error:", err);
          alert("Unable to load product card");
        });
    });
  });

  // Close modal
  document.querySelector('.modal-close').addEventListener('click', () => modal.style.display = 'none');
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.style.display = 'none';
  });

  // Mobile Swiper
  if (window.innerWidth <= 767) {
    const swWrapper = document.getElementById('mobile-swiper-wrapper');
    {% for block in section.blocks %}
      {% assign p = block.settings.product %}
      {% if p %}
        swWrapper.innerHTML += `<div class="swiper-slide">{% render 'custom-product-card', product: p %}</div>`;
      {% endif %}
    {% endfor %}

    new Swiper('#mobile-swiper', {
      slidesPerView: 1.15,
      spaceBetween: 15
    });
  }
});
</script>