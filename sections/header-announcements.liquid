
{% if template == 'index' %}
{% if section.blocks.size > 0 %}
  <div
    id="AnnouncementMarquee-{{ section.id }}"
    class="announcement-marquee"
    style="
      --announcement-speed: {{ section.settings.speed }}s;
      --announcement-bg: {{ section.settings.background_color }};
      --announcement-color: {{ section.settings.text_color }};
      --announcement-gap: {{ section.settings.gap }}px;
      --announcement-container-width: {{ section.settings.container_width }}px;
    "
  >
    {%- if section.settings.show_timer and settings.sale_timer_enable and settings.sale_timer_end_date != blank -%}
      <div
        class="announcement-marquee__timer"
        style="--announcement-timer-bg: {{ section.settings.timer_bg }}; --announcement-timer-color: {{ section.settings.timer_color }}; --announcement-timer-box-bg: {{ section.settings.timer_box_bg }}; --announcement-timer-box-color: {{ section.settings.timer_box_color }};"
      >
        {%- if section.settings.timer_text != blank -%}
          <span class="announcement-marquee__timer-text">{{ section.settings.timer_text }}</span>
        {%- endif -%}
        {% render 'urgency-timer', hide_closest: '.announcement-marquee__timer' %}
      </div>
      {%- comment -%}
        The home header group floats over the first section (style.css .home-header), so push the
        page content down by the timer row's height to keep the banner where it was without it.
        When the bar is hidden on scroll the row measures 0 — keep the last height so nothing jumps.
      {%- endcomment -%}
      <style>
        .content-for-layout {
          margin-top: var(--announcement-timer-height, 0px);
        }
      </style>
      <script>
        (function () {
          var row = document.querySelector('#AnnouncementMarquee-{{ section.id }} .announcement-marquee__timer');
          if (!row || !('ResizeObserver' in window)) return;
          var update = function () {
            var height = row.hidden ? 0 : row.offsetHeight;
            if (!row.hidden && height === 0) return;
            document.body.style.setProperty('--announcement-timer-height', height + 'px');
          };
          update();
          new ResizeObserver(update).observe(row);
          new MutationObserver(update).observe(row, { attributes: true, attributeFilter: ['hidden'] });
        })();
      </script>
    {%- endif -%}
    <div class="announcement-marquee__container">
      <div class="announcement-marquee__viewport">
        <div class="announcement-marquee__track">

          <div class="announcement-marquee__group">
            {% for block in section.blocks %}
              <div
                class="announcement-marquee__item"
                {% render 'schedule', s: block.settings %}
                {{ block.shopify_attributes }}
              >
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <span>{{ block.settings.text }}</span>
                {% endif %}
              </div>

              <span class="announcement-marquee__separator" {% render 'schedule', s: block.settings %}>
                {{ section.settings.separator }}
              </span>
            {% endfor %}
          </div>

          <div
            class="announcement-marquee__group"
            aria-hidden="true"
          >
            {% for block in section.blocks %}
              <div class="announcement-marquee__item" {% render 'schedule', s: block.settings %}>
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" tabindex="-1">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <span>{{ block.settings.text }}</span>
                {% endif %}
              </div>

              <span class="announcement-marquee__separator" {% render 'schedule', s: block.settings %}>
                {{ section.settings.separator }}
              </span>
            {% endfor %}
          </div>

        </div>
      </div>
    </div>
  </div>
  {%- comment -%} Drop out-of-schedule lines (and their separators) before the marquee is painted. {%- endcomment -%}
  {%- assign marquee_id = 'AnnouncementMarquee-' | append: section.id -%}
  {% render 'schedule-filter', root: marquee_id %}
  {%- unless request.design_mode -%}
    <script>
      (function () {
        var marquee = document.getElementById({{ marquee_id | json }});
        var container = marquee && marquee.querySelector('.announcement-marquee__container');
        if (container && !container.querySelector('.announcement-marquee__item')) container.hidden = true;
      })();
    </script>
  {%- endunless -%}
{% endif %}

<style>
  #AnnouncementMarquee-{{ section.id }} {
    width: 100%;
    background: var(--announcement-bg);
    color: var(--announcement-color);
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__container {
    position: relative;
    width: calc(100% - 30px);
    max-width: var(--announcement-container-width);
    margin: 0 auto;
    overflow: hidden;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );

    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__track {
    display: flex;
    width: max-content;
    align-items: center;
    will-change: transform;

    animation-name: announcement-scroll-{{ section.id }};
    animation-duration: var(--announcement-speed);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--announcement-gap);
    padding-right: var(--announcement-gap);
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__item {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    min-height: {{ section.settings.height }}px;
    white-space: nowrap;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    line-height: 1.2;
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__item a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__item a:hover {
    opacity: 0.75;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__separator {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.separator_size }}px;
    line-height: 1;
    opacity: 0.7;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 8px 15px;
    background: var(--announcement-timer-bg);
    color: var(--announcement-timer-color);
    font-size: {{ section.settings.font_size | plus: 2 }}px;
    font-weight: {{ section.settings.font_weight }};
    white-space: nowrap;
  }

  #AnnouncementMarquee-{{ section.id }}
  .announcement-marquee__timer[hidden] {
    display: none;
  }

  #AnnouncementMarquee-{{ section.id }}
  .urgency-timer__display {
    display: flex;
    gap: 8px;
  }

  #AnnouncementMarquee-{{ section.id }}
  .urgency-timer__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 54px;
    padding: 5px 8px;
    border-radius: 6px;
    background: var(--announcement-timer-box-bg);
    color: var(--announcement-timer-box-color);
  }

  #AnnouncementMarquee-{{ section.id }}
  .urgency-timer__value {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  #AnnouncementMarquee-{{ section.id }}
  .urgency-timer__label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    opacity: 0.8;
  }

  #AnnouncementMarquee-{{ section.id }}
  .urgency-timer__message {
    margin: 0;
  }

  {% if section.settings.pause_on_hover %}
    #AnnouncementMarquee-{{ section.id }}:hover
    .announcement-marquee__track {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes announcement-scroll-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__container {
      width: calc(100% - 20px);
    }

    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__viewport {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 12%,
        black 88%,
        transparent 100%
      );

      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 12%,
        black 88%,
        transparent 100%
      );
    }

    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__timer {
      gap: 10px;
      padding: 6px 10px;
      font-size: {{ section.settings.mobile_font_size | plus: 1 }}px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .urgency-timer__display {
      gap: 6px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .urgency-timer__unit {
      min-width: 44px;
      padding: 4px 6px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .urgency-timer__value {
      font-size: 16px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .urgency-timer__label {
      font-size: 8px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__item {
      min-height: {{ section.settings.mobile_height }}px;
      font-size: {{ section.settings.mobile_font_size }}px;
    }

    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__group {
      gap: {{ section.settings.mobile_gap }}px;
      padding-right: {{ section.settings.mobile_gap }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AnnouncementMarquee-{{ section.id }}
    .announcement-marquee__track {
      animation-play-state: paused;
    }
  }
</style>
{% else %}

<style>
  .header-top {
    display: none;
  }
</style>

{%endif %}
{% schema %}
{
  "name": "Announcement marquee",
  "class": "header-top",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 700,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scrolling speed",
      "info": "Lower value means faster scrolling",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 22
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop text spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile text spacing",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop bar height",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile bar height",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "px",
      "default": 0.2
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "separator_size",
      "label": "Separator size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause scrolling on hover",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Sale timer",
      "info": "End time and expiry action are set in Theme settings → Urgency sale timer."
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show sale timer",
      "default": false
    },
    {
      "type": "text",
      "id": "timer_text",
      "label": "Timer text",
      "default": "Sale ends in"
    },
    {
      "type": "color",
      "id": "timer_bg",
      "label": "Timer row background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Timer row text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "timer_box_bg",
      "label": "Timer box background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "timer_box_color",
      "label": "Timer box text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Extra 5% OFF + Free Shipping on Prepaid Orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Schedule",
          "info": "Optional. Store time zone. Leave empty to always show. The theme editor shows every line; check in Preview."
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "Show from date (YYYY-MM-DD, e.g. 2026-10-14)",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "start_time",
          "label": "Show from time (HH:MM 24-hour, e.g. 00:00)",
          "placeholder": "HH:MM"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "Hide after date (YYYY-MM-DD, e.g. 2026-10-31)",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "Hide after time (HH:MM 24-hour, e.g. 23:59)",
          "placeholder": "HH:MM"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Extra 5% OFF + Free Shipping on Prepaid Orders"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Free Shipping on Orders Above ₹1,299"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Easy Returns and Secure Payments"
          }
        }
      ]
    }
  ]
}
{% endschema %}