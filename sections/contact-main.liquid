<section class="contact-info">
  <div class="container">
    <div class="contact-info-main">

      <!-- LEFT SIDE -->
      <div class="contact-info-left">
        <h2 class="thomasmdheading">
          {{ section.settings.left_heading }}
        </h2>

        <div class="contact-info-list">
          {% for block in section.blocks %}
            <div class="item" {{ block.shopify_attributes }}>
              <div class="contact-info-card">

                {% if block.settings.icon != blank %}
                  <div class="contact-info-icon">
                    <img
                      src="{{ block.settings.icon | image_url }}"
                      alt="{{ block.settings.title | escape }}"
                      width="52"
                      height="52"
                    >
                  </div>
                {% endif %}

                <div class="contact-info-content">
                  <div class="thomassmheading">
                    {{ block.settings.title }}
                  </div>

                  <p>{{ block.settings.subtext }}</p>

                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" target="_blank" rel="noopener noreferrer">
                      {{ block.settings.link_text }}
                    </a>
                  {% endif %}
                </div>

              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="contact-info-right">
        <div class="contact-info-form">

          {% form 'contact', id: 'contact_form' %}

            {% if form.posted_successfully? %}

              <div class="form-success-state">
                <p class="form-success">
                  Thank you for contacting us! Your form has been submitted successfully. Our team will get back to you shortly.
                </p>
              </div>

            {% else %}

              <h3 class="thomasmdheading">
                {{ section.settings.form_heading }}
              </h3>

              <div class="form-row">

                <!-- FIRST NAME -->
                <div class="form-group w-50">
                  <label for="field-first-name" class="form-label">
                    First Name <span class="required-star">*</span>
                  </label>

                  <input
                    type="text"
                    id="field-first-name"
                    name="contact[first_name]"
                    class="form-control{% if form.errors contains 'first_name' %} field-has-error{% endif %}"
                    placeholder="First name"
                    pattern="[A-Za-z ]{3,50}"
                    minlength="3"
                    maxlength="50"
                    value="{{ form.value['first_name'] | escape }}"
                    required
                    oninvalid="showFieldError(this, 'First name must be at least 3 letters (alphabets only)')"
                    oninput="clearFieldError(this)"
                  >

                  <span class="field-error">
                    {% if form.errors contains 'first_name' %}
                      {{ form.errors.messages.first_name }}
                    {% endif %}
                  </span>
                </div>

                <!-- LAST NAME -->
                <div class="form-group w-50">
                  <label for="field-last-name" class="form-label">
                    Last Name
                  </label>

                  <input
                    type="text"
                    id="field-last-name"
                    name="contact[last_name]"
                    class="form-control{% if form.errors contains 'last_name' %} field-has-error{% endif %}"
                    placeholder="Last name"
                    pattern="[A-Za-z ]{3,50}"
                    minlength="3"
                    maxlength="50"
                    value="{{ form.value['last_name'] | escape }}"
                    oninvalid="showFieldError(this, 'Last name must be at least 3 letters (alphabets only)')"
                    oninput="clearFieldError(this)"
                  >

                  <span class="field-error">
                    {% if form.errors contains 'last_name' %}
                      {{ form.errors.messages.last_name }}
                    {% endif %}
                  </span>
                </div>

                <!-- EMAIL -->
                <div class="form-group w-100">
                  <label for="field-email" class="form-label">
                    Email <span class="required-star">*</span>
                  </label>

                  <input
                    type="email"
                    id="field-email"
                    name="contact[email]"
                    class="form-control{% if form.errors contains 'email' %} field-has-error{% endif %}"
                    placeholder="Email"
                    inputmode="email"
                    value="{{ form.value['email'] | escape }}"
                    required
                    oninvalid="showFieldError(this, 'Please enter valid email address')"
                    oninput="clearFieldError(this)"
                  >

                  <span class="field-error">
                    {% if form.errors contains 'email' %}
                      {{ form.errors.messages.email }}
                    {% endif %}
                  </span>
                </div>

                <!-- PHONE -->
                <div class="form-group w-50">
                  <label for="field-phone" class="form-label">
                    Mobile Number <span class="required-star">*</span>
                  </label>

                  <input
                    type="tel"
                    id="field-phone"
                    name="contact[phone]"
                    class="form-control{% if form.errors contains 'phone' %} field-has-error{% endif %}"
                    placeholder="Mobile Number"
                    pattern="[6-9][0-9]{9}"
                    maxlength="10"
                    value="{{ form.value['phone'] | escape }}"
                    required
                    oninvalid="showFieldError(this, 'Please enter valid 10-digit Indian mobile number')"
                    oninput="clearFieldError(this)"
                  >

                  <span class="field-error">
                    {% if form.errors contains 'phone' %}
                      {{ form.errors.messages.phone }}
                    {% endif %}
                  </span>
                </div>

                <!-- ENQUIRY -->
                <div class="form-group w-50 select-group">
                  <label for="field-enquiry" class="form-label">
                    Enquiry Type <span class="required-star">*</span>
                  </label>

                  <div class="select-wrapper">

                    <select
                      id="field-enquiry"
                      name="contact[enquiry_type]"
                      class="form-control custom-select{% if form.errors contains 'enquiry_type' %} field-has-error{% endif %}"
                      required
                      oninvalid="showFieldError(this, 'Please select an enquiry type')"
                      onchange="clearFieldError(this)"
                    >
                      <option value="">Enquiry type</option>

                      <option value="general"
                        {% if form.value.enquiry_type == 'general' %}
                          selected
                        {% endif %}
                      >
                        General
                      </option>

                      <option value="support"
                        {% if form.value.enquiry_type == 'support' %}
                          selected
                        {% endif %}
                      >
                        Support
                      </option>

                      <option value="sales"
                        {% if form.value.enquiry_type == 'sales' %}
                          selected
                        {% endif %}
                      >
                        Sales
                      </option>
                    </select>

                    <span class="select-arrow">
                      <svg width="12" height="7" viewBox="0 0 12 7" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 0.75L5.75 5.75L10.75 0.75" stroke="#767676" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>

                  </div>

                  <span class="field-error">
                    {% if form.errors contains 'enquiry_type' %}
                      {{ form.errors.messages.enquiry_type }}
                    {% endif %}
                  </span>
                </div>

                <!-- MESSAGE -->
                <div class="form-group w-100">
                  <label for="contact-message" class="form-label">
                    Message <span class="required-star">*</span>
                  </label>

                  <textarea
                    id="contact-message"
                    name="contact[body]"
                    class="form-control{% if form.errors contains 'body' %} field-has-error{% endif %}"
                    placeholder="Message"
                    minlength="10"
                    maxlength="100"
                    required
                    oninvalid="showFieldError(this, 'Please enter your message properly')"
                    oninput="clearFieldError(this)"
                  >{{ form.value['body'] | escape }}</textarea>

                  <span class="field-error">
                    {% if form.errors contains 'body' %}
                      {{ form.errors.messages.body }}
                    {% endif %}
                  </span>
                </div>

                <!-- TERMS -->
                <div class="form-group check-box w-100">
                  <div class="check-box-inner">

                    <input
                      type="checkbox"
                      id="field-terms"
                      name="contact[terms]"
                      required
                      oninvalid="showFieldError(this, 'You must agree to the Terms of Service')"
                      onchange="clearFieldError(this)"
                    >

                    <label for="field-terms">
                      I agree to the Terms of Service and Privacy Policy.
                    </label>

                  </div>

                  <span class="field-error"></span>
                </div>

                <!-- BUTTON -->
                <div class="form-group w-100">
                  <button type="submit" class="thomas-btn thomas-black-bg">
                    {{ section.settings.button_text }}
                  </button>
                </div>

              </div>

            {% endif %}

          {% endform %}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Main",
  "class": "contact-main",
  "settings": [
    {
      "type": "text",
      "id": "left_heading",
      "label": "Left Section Heading",
      "default": "Connect with Us"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Drop us a line. We'd love to hear from you."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Submit"
    }
  ],
  "blocks": [
    {
      "type": "contact_card",
      "name": "Contact Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Call us"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Mon - Sat : 10:00 am - 07:00 pm"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text",
          "default": "Click here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Main",
      "blocks": [
        {
          "type": "contact_card"
        },
        {
          "type": "contact_card"
        },
        {
          "type": "contact_card"
        }
      ]
    }
  ]
}
{% endschema %}

<script>
  /* ─────────────────────────────────────────
     REMOVE FAKE SUCCESS URL ACCESS
  ───────────────────────────────────────── */

  (function () {
    const url = new URL(window.location.href);

    const hasFakeSuccessUrl =
      url.searchParams.get('contact_posted') === 'true';

    const hasSuccessMessage =
      document.querySelector('.form-success-state');

    if (hasFakeSuccessUrl && !hasSuccessMessage) {
      window.location.replace(window.location.pathname);
    }
  })();

  /* ─────────────────────────────────────────
     SELECT ARROW TOGGLE
  ───────────────────────────────────────── */

  document.querySelectorAll('.custom-select').forEach((select) => {

    select.addEventListener('focus', function () {
      this.parentElement.classList.add('active');
    });

    select.addEventListener('blur', function () {
      this.parentElement.classList.remove('active');
    });

  });

  /* ─────────────────────────────────────────
     ERROR HELPERS
  ───────────────────────────────────────── */

  function showFieldError(field, message) {

    field.setCustomValidity(message);

    const errorSpan =
      field.parentElement.querySelector('.field-error');

    if (errorSpan) {
      errorSpan.textContent = message;
    }

    field.classList.add('field-has-error');
  }

  function clearFieldError(field) {

    field.setCustomValidity('');

    const errorSpan =
      field.parentElement.querySelector('.field-error');

    if (errorSpan) {
      errorSpan.textContent = '';
    }

    field.classList.remove('field-has-error');
  }

  /* ─────────────────────────────────────────
     NAME FIELDS
  ───────────────────────────────────────── */

  function setupNameField(field, label) {

    if (!field) return;

    field.addEventListener('input', function () {

      this.value =
        this.value.replace(/[^A-Za-z ]/g, '');

      clearFieldError(this);

    });

    field.addEventListener('blur', function () {

      const trimmed = this.value.trim();

      if (trimmed === '') {
        clearFieldError(this);
        return;
      }

      if (trimmed.length < 3) {
        showFieldError(
          this,
          label + ' must be at least 3 letters (alphabets only)'
        );
      } else {
        clearFieldError(this);
      }

    });

  }

  setupNameField(
    document.getElementById('field-first-name'),
    'First name'
  );

  setupNameField(
    document.getElementById('field-last-name'),
    'Last name'
  );

  /* ─────────────────────────────────────────
     PHONE VALIDATION
  ───────────────────────────────────────── */

  const phoneField =
    document.getElementById('field-phone');

  if (phoneField) {

    phoneField.addEventListener('input', function () {

      this.value =
        this.value.replace(/[^0-9]/g, '');

      if (this.value.length > 10) {
        this.value = this.value.slice(0, 10);
      }

      const phonePattern =
        /^[6-9][0-9]{9}$/;

      if (this.value === '') {
        clearFieldError(this);
        return;
      }

      if (this.value.length === 10) {

        if (!phonePattern.test(this.value)) {

          showFieldError(
            this,
            'Please enter valid 10-digit Indian mobile number'
          );

        } else {

          clearFieldError(this);

        }

      } else {

        clearFieldError(this);

      }

    });

  }

  /* ─────────────────────────────────────────
     EMAIL VALIDATION
  ───────────────────────────────────────── */

  const emailField =
    document.getElementById('field-email');

  if (emailField) {

    emailField.addEventListener('input', function () {

      const value = this.value.trim();

      const emailRegex =
        /^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$/i;

      if (value === '') {
        clearFieldError(this);
        return;
      }

      if (!emailRegex.test(value)) {

        showFieldError(
          this,
          'Please enter valid email address'
        );

      } else {

        clearFieldError(this);

      }

    });

  }

  /* ─────────────────────────────────────────
     TEXTAREA VALIDATION
  ───────────────────────────────────────── */

  (function () {

    const form =
      document.querySelector('.contact-info-form form');

    const textarea =
      document.getElementById('contact-message');

    if (!form || !textarea) return;

    textarea.addEventListener('input', function () {

      let value = this.value;

      value = value.replace(/\s+/g, ' ');
      value = value.trimStart();

      if (value.length > 100) {
        value = value.slice(0, 100);
      }

      this.value = value;

    });

    form.addEventListener('submit', function (e) {

      const value = textarea.value.trim();

      if (value.length < 10 || value.length > 100) {

        e.preventDefault();

        showFieldError(
          textarea,
          'Message must be between 10 and 100 characters (excluding extra spaces)'
        );

        textarea.reportValidity();

      } else {

        clearFieldError(textarea);

      }

    });

  })();
</script>

<style>
  .required-star {
    color: #d32f2f;
    margin-left: 2px;
  }

  .form-label {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    font-weight: 500;
  }

  .check-box {
    flex-direction: column !important;
    align-items: flex-start !important;
  }

  .check-box-inner {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .select-group {
    position: static;
  }

  .select-wrapper {
    position: relative;
  }

  .custom-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    cursor: pointer;
    padding-right: 45px;
    width: 100%;
  }

  .select-arrow {
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .select-wrapper.active .select-arrow {
    transform: translateY(-50%) rotate(180deg);
  }

  .custom-select:focus {
    outline: none;
  }

  .field-error {
    display: block;
    color: #d32f2f;
    font-size: 12px;
    margin-top: 4px;
    min-height: 16px;
    line-height: 1.3;
  }

  .field-has-error {
    border-color: #d32f2f !important;
  }

  /* SUCCESS MESSAGE */

  .form-success-state {
    width: 100%;
    padding: 18px 20px;
    background: #edf9ed;
    border: 1px solid #28a745;
    border-radius: 6px;
    text-align: center;
    margin-top: 20px;
  }

  .form-success {
    color: #28a745;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    margin: 0;
  }
</style>