   or request.page_type == 'collection'
   or request.page_type == 'cart'
   or page.handle == 'privacy-policy'
   or page.handle == 'about-us'
      or page.handle == 'contact-us'
   or page.handle == 'store-locator'

   or page.handle == 'terms-and-conditions'
   or page.handle == 'shipping-policy'
   or page.handle == 'refund-policy' %} {% assign enable_secondary_header = true %}
{% else %}
  {{ announcement_bar }}
  {% assign enable_secondary_header = false %}
{% endif %} {% endcomment %}
 {% if request.page_type == 'product' 
   or request.page_type == 'collection'
   or request.path == '/collections'
   or request.path == '/search'
   or request.page_type == 'cart'
   or request.page_type == 'blog'
   or request.page_type == 'article'
   or page.handle == 'privacy-policy'
   or page.handle == 'about-us'
   or page.handle == 'contact-us'
   or page.handle == 'store-locator'
