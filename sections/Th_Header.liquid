<script>
document.addEventListener("DOMContentLoaded", function () {

  const menuBtn = document.querySelector(".nav-icon-menu");

  if(menuBtn){

    menuBtn.addEventListener("click", function () {

      document.body.classList.add("popup-overlay");

    });

  }

});
document.body.classList.remove("popup-overlay");
document.querySelectorAll('.menu-item > .menu-arrow').forEach(arrow => {
  arrow.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();

    const menuItem = this.closest('.menu-item');
    const megaMenu = menuItem.querySelector(':scope > .mega-menu');

    const isActive = menuItem.classList.contains('active');

    document.querySelectorAll('.menu-item').forEach(item => {
      item.classList.remove('active');
    });

    document.querySelectorAll('.mega-menu').forEach(menu => {
      menu.classList.remove('active');
    });

    if (!isActive) {
      menuItem.classList.add('active');
      megaMenu?.classList.add('active');
    }
  });
});
document.querySelectorAll('.mega-column .menu-arrow').forEach(arrow => {
  arrow.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();

    const megaColumn = this.closest('.mega-column');
    const submenu = megaColumn.querySelector(':scope > .submenu');

    const isActive = megaColumn.classList.contains('active');

    // same mega-menu ke andar hi reset karo
    const parentMegaMenu = megaColumn.closest('.mega-menu');

    parentMegaMenu.querySelectorAll('.mega-column').forEach(col => {
      col.classList.remove('active');
    });

    parentMegaMenu.querySelectorAll('.submenu').forEach(menu => {
      menu.classList.remove('active');
    });

    if (!isActive) {
      megaColumn.classList.add('active');
      submenu?.classList.add('active');
    }
  });
});
</script>



