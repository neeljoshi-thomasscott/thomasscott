<style>.footer-social i {
  font-size: 18px;
  color: #000;
}
.newsletter-success {
  margin-top: 15px;
  color: #fff;
}

.newsletter-success p {
  font-size: 14px;
  margin-bottom: 10px;
}

.newsletter-divider {
  border: none;
  height: 1px;
  background: rgba(255,255,255,0.3);
  width: 100%;
}
.form-group {
  position: relative;
}
.newsletter {
  width: 100%;
  padding-right: 45px; /* 🔥 space for arrow */
}

</style>


<footer class="footer">
  <div class="container">
    
    <!-- TOP -->
    <div class="footer-top d-flex">

      <!-- LEFT: NEWSLETTER -->
      <div class="footer-left">
        <p>{{ section.settings.newsletter_title }}</p>
        <div class="thomasmdheading">
          {{ section.settings.newsletter_subtext }}
        </div>
{% form 'customer', class: 'newsletter-form' %}

  {% if form.posted_successfully? %}
    <div class="newsletter-success">
      <p>You're subscribed! Welcome to the fam.</p>
      <hr class="newsletter-divider">
    </div>
  {% else %}
        <div class="form-group relative">
  <input 
    type="email" 
    name="contact[email]" 
    class="newsletter"
    placeholder="Enter Your Email ID"
    required
  >
  <button type="submit" class="submit-btn">
    <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
      <path d="M0.5625 5.0625L14.0625 5.0625" stroke="white" stroke-width="1.125"/>
      <path d="M9.5625 0.5625L14.0625 5.0625L9.5625 9.5625" stroke="white" stroke-width="1.125"/>
    </svg>
  </button>

  <!-- 🔥 ERROR MESSAGE -->
  <span class="email-error" style="color:red; font-size:12px; display:none;">
    Please enter a valid email address
  </span>
</div>
    
    

  {% endif %}

{% endform %}
      
      </div>

      <!-- RIGHT: MENUS -->
      <div class="footer-right">

        {% for block in section.blocks %}
          {% if block.type == 'menu' %}
            <div class="footer-col">
              <h6 class="thomassmheading footer-toggle">
                {{ block.settings.heading }}
                <svg width="13" height="8" viewBox="0 0 13 8" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M11.75 0.75L6.25 6.75L0.75 0.75" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
              </h6>

              <ul class="footer-list">
                {% for link in linklists[block.settings.menu].links %}
                  <li>
                    <a href="{{ link.url }}" {% if link.title == 'TRACK ORDER' %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}>{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    </div>

    <!-- BOTTOM -->
    <div class="footer-bottom">

 
 <ul class="footer-legal">
          {% for link in linklists[section.settings.legal_menu1].links %}
            <li><a href="{{ link.url }}" target="_blank">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      <!-- SOCIAL -->
      <ul class="footer-social">
