<script>
document.addEventListener('DOMContentLoaded', function () {
  const slider = document.getElementById('blog-slider');
  if (!slider) return;

  let scrollAmount = 0;
  const slideWidth = 100; // percentage
  const intervalTime = 4000; // 4 seconds

  function autoScroll() {
    scrollAmount += slideWidth;
    slider.style.transition = 'transform 0.8s ease';
    slider.style.transform = `translateX(-${scrollAmount}%)`;

    // Reset when end reached
    if (scrollAmount >= (slider.children.length * 100) - 100) {
      setTimeout(() => {
        slider.style.transition = 'none';
        slider.style.transform = 'translateX(0)';
        scrollAmount = 0;
      }, 800);
    }
  }

  // Start auto scroll
  let autoInterval = setInterval(autoScroll, intervalTime);

  // Pause on hover
  slider.addEventListener('mouseenter', () => clearInterval(autoInterval));
  slider.addEventListener('mouseleave', () => {
    autoInterval = setInterval(autoScroll, intervalTime);
  });
});
</script>

<script>
  (() => {
