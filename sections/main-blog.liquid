<blog-posts-list section-id="{{ section.id }}" class="blog-main">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <section
    class="th-blog-listing color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-style', settings: section.settings %}"
    data-testid="blog-posts"
  >
    <div class="th-blog-listing__content container">
      <div class="th-blog-listing__toolbar">
        <h1 class="th-blog-listing__heading">{{ blog.title | default: 'Blogs' }}</h1>

        <div class="th-blog-listing__filters" role="tablist" aria-label="Blog filters">
          {% assign all_blogs_path = routes.root_url | append: 'blogs' %}
          

          {% assign has_blog_items = false %}
          {% for blog_item in blogs %}
            {% assign has_blog_items = true %}
            <a
              class="th-blog-listing__filter{% if blog_item.handle == blog.handle %} is-active{% endif %}"
              href="{{ blog_item.url }}"
              role="tab"
              aria-selected="{% if blog_item.handle == blog.handle %}true{% else %}false{% endif %}"
            >
              {% comment %} {{ blog_item.title }} {% endcomment %} All Blogs
            </a>
          {% endfor %}

          {% unless has_blog_items %}
            <a class="th-blog-listing__filter is-active" href="{{ blog.url }}" role="tab" aria-selected="true">
              {% comment %} {{ blog.title }}{% endcomment %} All Blogs 
            </a>
          {% endunless %}
        </div>

        <form class="th-blog-listing__search" data-blog-search role="search" action="{{ blog.url }}">
          <span class="th-blog-listing__search-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.78685 16.7887C13.2255 16.7887 16.8237 13.1983 16.8237 8.76935C16.8237 4.34039 13.2255 0.75 8.78685 0.75C4.34822 0.75 0.75 4.34039 0.75 8.76935C0.75 13.1983 4.34822 16.7887 8.78685 16.7887Z" stroke="#767676" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18.8332 18.9272L14.5469 14.6502" stroke="#767676" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <input
            type="search"
            name="q"
            value="{{ request.params.q | escape }}"
            placeholder="search blogs"
            aria-label="Search blogs"
            class="th-blog-listing__search-input"
            data-blog-search-input
          >
          <button type="submit" class="th-blog-listing__search-btn">Search</button>
        </form>
      </div>

      {% paginate blog.articles by 12 %}
        <div class="th-blog-listing__grid" data-blog-grid>
          {% for article in blog.articles %}
            <article class="th-blog-card" data-blog-card data-title="{{ article.title | downcase | escape }}">
              <a href="{{ article.url }}" class="th-blog-card__media" aria-label="{{ article.title | escape }}">
                {% if article.image %}
                  {{
                    article.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 360, 540, 720, 900',
                      class: 'th-blog-card__image',
                      alt: article.title
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'th-blog-card__placeholder' }}
                {% endif %}
              </a>

              <div class="th-blog-card__content">
                <p class="th-blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
                <h3 class="th-blog-card__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h3>
                <a href="{{ article.url }}" class="th-blog-card__read-more">Continue Reading</a>
              </div>
            </article>
          {% endfor %}
        </div>

        {% comment %} {% if paginate.pages > 1 and paginate.next %}
          <div class="th-blog-listing__pagination-dot-wrap">
            <a href="{{ paginate.next.url }}" class="th-blog-listing__pagination-dot" aria-label="Load more blog posts"></a>
          </div>
        {% endif %}{% endcomment %}
{% if paginate.pages > 1 and paginate.next %}
