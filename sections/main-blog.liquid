<style>
html,body{
  letter-spacing:2%
}
.editorial-carousel {
  --side-visible: 16%;
  --slide-gap: 10px;
  --slide-scale-side: 1;
  --transition: 500ms cubic-bezier(0.22, 0.61, 0.36, 1);
  --nav-size: 52px;

  position: relative;
  width: 100%;
  padding: 0;
  box-sizing: border-box;
}

.editorial-carousel__viewport {
  position: relative;
  overflow: hidden;
  width: 100%;
}

.editorial-carousel__track {
  position: relative;
  min-height: 1px;
  cursor: grab;
  user-select: none;
}
.editorial-slide {
  position: absolute;
  top: 0;
  left: 50%;
  width: calc(100% - (var(--side-visible) * 2) - (var(--slide-gap) * 2));
  height: auto;
  overflow: hidden;
  background: transparent;
  transform-origin: center center;
  transition:
    transform var(--transition),
    opacity var(--transition),
    filter var(--transition);
  opacity: 0;
  pointer-events: none;
  will-change: transform, opacity, filter;
}

.editorial-slide__image {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
}

.editorial-slide__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.34) 0%,
    rgba(0, 0, 0, 0.12) 28%,
    rgba(0, 0, 0, 0.04) 48%,
    rgba(0, 0, 0, 0) 68%
  );
  pointer-events: none;
}

.editorial-slide__content {
  position: absolute;
  left: 50%;
  bottom: 84px;
  transform: translateX(-50%);
  width: min(90%, 760px);
  text-align: center;
  z-index: 2;
  color: #fff;
  transition: opacity var(--transition), transform var(--transition);
}

.editorial-slide__title {
  margin: 0 0 28px;
  font-size: 24px;
  font-weight: 500;
  Line height: 32px;
}

.editorial-slide__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9.5px 28.4px;
  background: #f2efef;
  color: #2e2a2a;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 8%;
  transition: background 0.25s ease, transform 0.25s ease;
}

.editorial-slide__button:hover {
  background: #ffffff;
  transform: translateY(-1px);
}
.editorial-slide.is-active {
  transform: translateX(-50%) scale(1);
  opacity: 1;
  z-index: 3;
  filter: blur(0);
  pointer-events: auto;
  
}

.editorial-slide.is-prev {
  transform: translateX(calc(-100% - var(--slide-gap))) scale(var(--slide-scale-side));
  opacity: 0.7;
  z-index: 2;
  filter: grayscale(8%) brightness(0.72);
}

.editorial-slide.is-next {
  transform: translateX(var(--slide-gap)) scale(var(--slide-scale-side));
  opacity: 0.7;
  z-index: 2;
  filter: grayscale(8%) brightness(0.72);
}

.editorial-slide.is-hidden-left {
  transform: translateX(calc(-50% - 140%)) scale(0.9);
  opacity: 0;
  z-index: 1;
}

.editorial-slide.is-hidden-right {
  transform: translateX(calc(-50% + 140%)) scale(0.9);
  opacity: 0;
  z-index: 1;
}

.editorial-slide:not(.is-active) .editorial-slide__content {
  opacity: 0;
  transform: translateX(-50%) translateY(18px);
  pointer-events: none;
}

.editorial-carousel__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: var(--nav-size);
  height: var(--nav-size);
  border: 0;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.86);
  color: #111;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  z-index: 5;
  transition: background 0.25s ease, transform 0.25s ease, opacity 0.25s ease;
}

.editorial-carousel__nav:hover {
  background: #fff;
}

.editorial-carousel__nav--prev {
  left: 18px;
}

.editorial-carousel__nav--next {
  right: 18px;
}

@media (max-width: 991px) {
  .editorial-carousel {
    display: none;
  }
}
@media (max-width: 767px) {
  .editorial-carousel {
    --side-visible: 5%;
    --mobile-slide-height: 413px;
    --mobile-side-scale: 1;
    --mobile-content-width: 86%;
  }

  .editorial-carousel {
    display: block;
  }

  .editorial-carousel__viewport {
    height: var(--mobile-slide-height) !important;
    overflow: hidden;
  }

  .editorial-carousel__track {
    height: var(--mobile-slide-height) !important;
    cursor: grab;
  }

  .editorial-slide {
    width: calc(100% - (var(--side-visible) * 2));
    height: var(--mobile-slide-height) !important;
    overflow: hidden;
    border-radius: 0;
  }
  
  .editorial-slide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
    display: block;
    pointer-events: none;
  }

  .editorial-slide__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.42) 0%,
      rgba(0, 0, 0, 0.18) 35%,
      rgba(0, 0, 0, 0.04) 58%,
      rgba(0, 0, 0, 0) 76%
    );
  }

  .editorial-slide__content {
    left: 50%;
    bottom: 44px;
    transform: translateX(-50%);
    width: var(--mobile-content-width);
    max-width: 320px;
  }

  .editorial-slide__title {
    margin: 0 0 18px;
    font-size:18px;
    line-height:24px;
  }

  .editorial-slide__button {
    min-width: 185px;
    height: 52px;
    padding: 0 24px;
    font-size: 15px;
    letter-spacing: 1px;
  }

  .editorial-slide.is-active {
    transform: translateX(-50%) scale(1);
    opacity: 1;
    z-index: 3;
    filter: none;
    pointer-events: auto;
  }

  .editorial-slide.is-prev {
    transform: translateX(-103%) scale(var(--mobile-side-scale));
    opacity: 0.9;
    z-index: 2;
    filter: brightness(0.82);
  }

  .editorial-slide.is-next {
    transform: translateX(3%) scale(var(--mobile-side-scale));
    opacity: 0.9;
    z-index: 2;
    filter: brightness(0.82);
  }

  .editorial-slide.is-hidden-left {
    transform: translateX(-160%) scale(1);
    opacity: 0;
    z-index: 1;
  }

  .editorial-slide.is-hidden-right {
    transform: translateX(60%) scale(1);
    opacity: 0;
    z-index: 1;
  }

  .editorial-slide:not(.is-active) .editorial-slide__content {
    opacity: 0;
    transform: translateX(-50%) translateY(14px);
    pointer-events: none;
  }

  .editorial-carousel__nav {
    width: 42px;
    height: 42px;
    font-size: 18px;
    background: rgba(255, 255, 255, 0.88);
  }

  .editorial-carousel__nav--prev {
    left: 8px;
  }

  .editorial-carousel__nav--next {
    right: 8px;
  }
}
</style>
