<script>
document.querySelectorAll('[data-carousel]').forEach((carousel) => {
  const viewport = carousel.querySelector('.editorial-carousel__viewport');
  const track = carousel.querySelector('.editorial-carousel__track');
  const slides = Array.from(track.querySelectorAll('.editorial-slide'));
  const prevBtn = carousel.querySelector('.editorial-carousel__nav--prev');
  const nextBtn = carousel.querySelector('.editorial-carousel__nav--next');

  if (!slides.length) return;

  let currentIndex = slides.findIndex(s => s.classList.contains('is-active'));
  if (currentIndex < 0) currentIndex = 0;

  let autoplay = null;
  const autoplayDelay = 3000;

  let isDragging = false;
  let startX = 0;
  let diffX = 0;
  let hasMoved = false;

  const DRAG_THRESHOLD = 50;

  /* ---------------- CORE ---------------- */

  function getPrev(i) {
    return (i - 1 + slides.length) % slides.length;
  }

  function getNext(i) {
    return (i + 1) % slides.length;
  }

  function clearState(slide) {
    slide.classList.remove(
      'is-active',
      'is-prev',
      'is-next',
      'is-hidden-left',
      'is-hidden-right'
    );
  }

  function setHeight() {
  const isMobile = window.innerWidth <= 767;

  if (isMobile) {
    const mobileHeight = 413;
    viewport.style.height = `${mobileHeight}px`;
    track.style.height = `${mobileHeight}px`;

    slides.forEach((slide) => {
      slide.style.height = `${mobileHeight}px`;
    });

    return;
  }

  const active = slides[currentIndex];
  if (!active) return;

  const img = active.querySelector('.editorial-slide__image');

  const apply = () => {
    const h = active.offsetHeight;
    if (!h) return;

    viewport.style.height = `${h}px`;
    track.style.height = `${h}px`;

    slides.forEach((slide) => {
      slide.style.height = `${h}px`;
    });
  };

  if (img && !img.complete) {
    img.onload = apply;
  } else {
    requestAnimationFrame(apply);
  }
}

  function update() {
    const prev = getPrev(currentIndex);
    const next = getNext(currentIndex);

    slides.forEach((slide, i) => {
      clearState(slide);

      if (i === currentIndex) {
        slide.classList.add('is-active');
      } else if (i === prev) {
        slide.classList.add('is-prev');
      } else if (i === next) {
        slide.classList.add('is-next');
      } else {
        const diff = (i - currentIndex + slides.length) % slides.length;
        slide.classList.add(diff < slides.length / 2 ? 'is-hidden-right' : 'is-hidden-left');
      }
    });

    setHeight();
  }

  function goTo(i) {
    currentIndex = (i + slides.length) % slides.length;
    update();
  }

  function next() {
    goTo(currentIndex + 1);
  }

  function prev() {
    goTo(currentIndex - 1);
  }

  /* ---------------- AUTOPLAY ---------------- */
/* ---------------- AUTOPLAY ---------------- */

function startAuto() {
  stopAuto();

  autoplay = setInterval(() => {
    next();
  }, 3000);
}

function stopAuto() {
  if (autoplay) {
    clearInterval(autoplay);
    autoplay = null;
  }
}

/* ---------------- HOVER ---------------- */

// REMOVE OLD hover events completely

// carousel.addEventListener('mouseenter', stopAuto);
// carousel.addEventListener('mouseleave', () => {
//   if (!isDragging) startAuto();
// });

  /* ---------------- BUTTONS ---------------- */

  prevBtn?.addEventListener('click', () => {
    prev();
    startAuto();
  });

  nextBtn?.addEventListener('click', () => {
    next();
    startAuto();
  });

  /* ---------------- DRAG ---------------- */

  function onDown(e) {
    if (e.button !== 0) return;

    isDragging = true;
    hasMoved = false;
    startX = e.clientX;
    diffX = 0;

    track.style.cursor = 'grabbing';
    stopAuto();
  }

  function onMove(e) {
    if (!isDragging) return;

    diffX = e.clientX - startX;

    if (Math.abs(diffX) > 5) {
      hasMoved = true;
    }
  }

  function onUp() {
    if (!isDragging) return;

    isDragging = false;
    track.style.cursor = '';

    if (Math.abs(diffX) > DRAG_THRESHOLD) {
      diffX < 0 ? next() : prev();
    }

    setTimeout(() => {
      hasMoved = false;
    }, 0);

    startAuto();
  }

  track.addEventListener('mousedown', onDown);
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onUp);
  window.addEventListener('mouseleave', onUp);

  /* ---------------- CLICK SLIDES ---------------- */

  slides.forEach((slide, i) => {
    slide.addEventListener('click', (e) => {
      if (hasMoved) {
        e.preventDefault();
        return;
      }

      if (i !== currentIndex) {
        goTo(i);
        startAuto();
      }
    });
  });

  /* ---------------- HOVER ---------------- */

  carousel.addEventListener('mouseenter', stopAuto);
  carousel.addEventListener('mouseleave', () => {
    if (!isDragging) startAuto();
  });

  /* ---------------- RESIZE ---------------- */

  window.addEventListener('resize', setHeight);

  /* ---------------- INIT ---------------- */
carousel.setAttribute('data-autoplay', 'true');
  update();
  function startAuto() {
  stopAuto();

  autoplay = setInterval(() => {
    next();

    // smooth continuous feeling
    track.style.transition = 'transform 0.6s ease';
  }, autoplayDelay);
}
});
</script>

