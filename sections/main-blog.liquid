<script>
(() => {
  const initInfiniteScroll = () => {
    const container = document.querySelector('[data-blog-grid]');
    const loadMore = document.querySelector('[data-load-more]');

    if (!container || !loadMore) return;

    let loading = false;
    let nextUrl = loadMore.dataset.nextUrl;

    const observer = new IntersectionObserver(async (entries) => {
      const entry = entries[0];

      if (!entry.isIntersecting || loading || !nextUrl) return;

      loading = true;

      try {
        const response = await fetch(nextUrl);
        const html = await response.text();

        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        const newItems = doc.querySelectorAll('[data-blog-card]');
        const newLoadMore = doc.querySelector('[data-load-more]');

        newItems.forEach((item) => {
          container.appendChild(item);
        });

       if (newLoadMore && newLoadMore.dataset.nextUrl) {
  nextUrl = newLoadMore.dataset.nextUrl;
} else {
  nextUrl = null;

  observer.unobserve(loadMore);

  loadMore.style.display = 'none';

  observer.disconnect();
}
      } catch (error) {
        console.error('Load more failed:', error);
      }

      loading = false;
    }, {
      rootMargin: '300px'
    });

    observer.observe(loadMore);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInfiniteScroll);
  } else {
    initInfiniteScroll();
  }
})();
</script>
