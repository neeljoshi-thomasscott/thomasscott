{% assign selected_collection = section.settings.collection %}

{% if selected_collection != blank %}
  <div class="bestseller-slider bestseller-slider-new">

    {% for product in selected_collection.products limit: section.settings.products_to_show %}
      
      {%- liquid
        assign product_has_swatches = false
        for product_option in product.options_with_values
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          if swatch_count > 0
            assign product_has_swatches = true
            break
          endif
        endfor
      -%}

      {% capture product_card_children %}
        <div class="featured-product-content-top">
          {% content_for 'block', type: 'product-title', id: 'featured-product-title', product: product %}

          {% content_for 'block', type: '_featured-product-price', id: 'featured-product-price', product: product %}
        </div>

        {% content_for 'block', type: '_featured-product-gallery', id: 'featured-product-gallery', product: product %}

        {% if product_has_swatches %}
          <div class="featured-product-content-bottom">
            {% content_for 'block', type: 'swatches', id: 'featured-product-swatches', product: product %}
          </div>
        {% endif %}
      {% endcapture %}

      <div class="item">
        {% render 'product-card',
          children: product_card_children,
          product: product,
          product_card_gap: 8
        %}
      </div>

    {% endfor %}

  </div>
{% endif %}