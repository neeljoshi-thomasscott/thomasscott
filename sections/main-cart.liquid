

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

<style>
  {% comment %} .cart-title{text-align:center !important;} {% endcomment %}
  {% comment %} @media (max-width:767px){
    .page_cart .bestseller-sec, footer{position:relative;z-index:-1;}
    
  } {% endcomment %}

  @media (max-width: 767px) {
    .recommendation-grid{display:block !important;}
    .recommendation-grid .grid-item {
        margin-right: 10px;
    }
    
}
</style>
<cart-items-component id="shopify-section-main-cart"
  class="cart-items-component cart-main"
  data-section-id="{{ section.id }}"
>
  <template id="empty-cart-template">
    <div class="kumud section-background color-{{ section.settings.color_scheme }}"></div>
    <div
      class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
       
        <div class="cart-page__title">
          <a href="javascript:history.back()" class="media-back-btn" aria-label="Go Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none"> <path d="M6.75 11.75L0.75 6.25L6.75 0.750004" stroke="#1E1E1E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>
          </a>
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
          <a href="/a/wishlist-hero/wishlist" class="cart-wishlist"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" fill="none">
<rect width="36" height="36" fill="white" fill-opacity="0.4"/>
<path d="M22.2264 10C20.3868 10 18.7983 11.064 18 12.616C17.2017 11.064 15.6132 10 13.7736 10C11.1366 10 9 12.184 9 14.872C9 17.56 10.6353 20.024 12.7485 22.048C14.8617 24.072 18 26 18 26C18 26 21.0366 24.104 23.2515 22.048C25.614 19.856 27 17.568 27 14.872C27 12.176 24.8634 10 22.2264 10Z" fill="white" fill-opacity="0.4" stroke="#1E1E1E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg></a>
        </div>
        
      {%- comment -%} ─── PROMO BANNER ─── {%- endcomment -%}
      <div class="cart-promo-banner mobile-only">
        Get ₹500 Off On Shopping Above ₹4000
      </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  {% # theme-check-disable UniqueStaticBlockId %}
  <div class=" section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="container  color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page-left">
        <div class="cart-page__title">
             <a href="javascript:history.back()" class="media-back-btn" aria-label="Go Back">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none"> <path d="M6.75 11.75L0.75 6.25L6.75 0.750004" stroke="#1E1E1E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/> </svg>
          </a>
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
            <a href="/a/wishlist-hero/wishlist" class="cart-wishlist"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" fill="none">
<rect width="36" height="36" fill="white" fill-opacity="0.4"/>
<path d="M22.2264 10C20.3868 10 18.7983 11.064 18 12.616C17.2017 11.064 15.6132 10 13.7736 10C11.1366 10 9 12.184 9 14.872C9 17.56 10.6353 20.024 12.7485 22.048C14.8617 24.072 18 26 18 26C18 26 21.0366 24.104 23.2515 22.048C25.614 19.856 27 17.568 27 14.872C27 12.176 24.8634 10 22.2264 10Z" fill="white" fill-opacity="0.4" stroke="#1E1E1E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg></a>
        </div>
 {%- comment -%} ─── PROMO BANNER ─── {%- endcomment -%}
      <div class="cart-promo-banner mobile-only">
        Get ₹500 Off On Shopping Above ₹4000
      </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
        </div>
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
  {% # theme-check-enable UniqueStaticBlockId %}
</cart-items-component>
{%if cart.item_count > 0 %}
<div class="mobile-sticky-pay-button">
  
  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}
  <button
    onclick="window.location.href =  '/checkout'"
    type="button"
    id="checkout"
    class="cart__checkout-button button cart__checkout-button--with-total"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    {%- comment -%}
      FIX 1: 'content.pay' was a missing key — hardcoded "PAY" instead.
      FIX 2: button_price uses | money (not money_with_currency) so no "INR" suffix.
              total_price may have "INR" if currency_code_enabled_cart_total is on.
              button_price is ALWAYS clean e.g. ₹2,926.00
    {%- endcomment -%}
    <span class="button-text">
        Checkout
    </span>
  </button>
</div>

{%endif %}
{% stylesheet %}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
   
  ]
}
{% endschema %}
