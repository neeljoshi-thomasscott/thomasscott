          {% endfor %}
        {% else %}
          <div class="item">
            <div class="categroy-card">
              <a href="#">
                <div class="categroy-thumb">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg w-full lazyload' }}
                </div>
                <div class="thomassmheading">
                  No collections have been added yet
                </div>
              </a>
            </div>
          </div>
        {% endif %}
      </div>
    </div> {% endcomment %}
  </div>
</section>
{%- assign grid_id = 'shop-by-category-' | append: section.id -%}
{% render 'schedule-filter', root: grid_id %}

{% schema %}
{
  "name": "Collection Grid ",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "header",
          "content": "Tag"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag text",
          "info": "e.g. FESTIVE PICK. Leave empty for no tag."
        },
        {
          "type": "color",
          "id": "tag_bg_start",
          "label": "Tag background (left)",
          "default": "#5a0f24"
        },
        {
          "type": "color",
          "id": "tag_bg_end",
          "label": "Tag background (right)",
          "default": "#a8264f"
        },
        {
          "type": "color",
          "id": "tag_color",
          "label": "Tag text color",
          "default": "#f3d27a"
        },
        {
          "type": "header",
          "content": "Tag schedule",
          "info": "Optional. Store time zone. Leave empty to always show the tag. The theme editor always shows it; check in Preview."
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "Show from date (YYYY-MM-DD, e.g. 2026-10-14)",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "start_time",
          "label": "Show from time (HH:MM 24-hour, e.g. 00:00)",
          "placeholder": "HH:MM"
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "Hide after date (YYYY-MM-DD, e.g. 2026-10-31)",
          "placeholder": "YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "Hide after time (HH:MM 24-hour, e.g. 23:59)",
          "placeholder": "HH:MM"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}