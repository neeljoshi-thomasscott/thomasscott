<style>
  .categroy-card .categroy-thumb{
    
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .categroy-card .categroy-thumb img{
    max-width:100%;
    max-height:146px;
    width: auto;
  }
  .categroy-card{
    position: relative;
  }
  .categroy-card .categroy-tag{
    position: absolute;
    top: 10px;
    left: 0;
    z-index: 1;
    padding: 4px 18px 4px 10px;
    background: linear-gradient(90deg, var(--categroy-tag-from), var(--categroy-tag-to));
    color: var(--categroy-tag-color);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    clip-path: polygon(0 0, 100% 0, calc(100% - 9px) 50%, 100% 100%, 0 100%);
  }
  @media (max-width: 749px){
    .categroy-card .categroy-tag{
      top: 6px;
      padding: 3px 14px 3px 7px;
      font-size: 9px;
    }
  }
</style>
<section class="categroy-sec" id="shop-by-category-{{ section.id }}">
  <div class="container">
    <div class="top-heading">
      <h1 class="thomasxlheading">
        {% if section.settings.heading != '' %}
          {{ section.settings.heading | escape }}
        {% else %}
          Shop by category
        {% endif %}
      </h1>
    </div>
    <div class="slider-rl">

  <!-- FIRST ROW -->
  <div class="categroy-list categroy-list-1">

    {% for block in section.blocks limit: 4 %}

      {% assign block_collection = block.settings.collection %}
      {% assign custom_image = block.settings.custom_image %}
      {% assign custom_title = block.settings.custom_title | strip %}

      {% if block_collection %}

        <div class="item">

          <div class="categroy-card" {{ block.shopify_attributes }}>
            {%- if block.settings.tag_text != blank -%}
              <span
                class="categroy-tag"
                style="--categroy-tag-from: {{ block.settings.tag_bg_start }}; --categroy-tag-to: {{ block.settings.tag_bg_end }}; --categroy-tag-color: {{ block.settings.tag_color }};"
                {% render 'schedule', s: block.settings %}
              >
                {{- block.settings.tag_text | escape -}}
              </span>
            {%- endif -%}
            <a href="{{ block_collection.url }}">

              <div class="categroy-thumb">

                {% if custom_image %}
                 <img  src="{{ custom_image |  image_url: width: 268 }}" loading="lazy" width="134" height="146" fetchpriority="auto" class="lazyload" alt="{{ custom_title | default: block_collection.title }}" />

                  {% comment %} {{ custom_image
                    | image_url: width: 268
                    | image_tag:
                      loading: 'lazy',
                      width: 134,
                      height: 146,
                      fetchpriority: 'auto',
                      class: 'lazyload',
                      alt: custom_title | default: block_collection.title
                  }} {% endcomment %}

                {% elsif block_collection.image %}

                  {{ block_collection.image
                    | image_url: width: 268
                    | image_tag:
                      loading: 'lazy',
                      width: 134,
                      height: 146,
                      fetchpriority: 'auto',
                      class: 'lazyload',
                      
                      alt: block_collection.title
                  }}

                {% endif %}

              </div>

              <div class="thomassmheading">
                {{ custom_title | default: block_collection.title }}
              </div>

            </a>
          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

  <!-- SECOND ROW -->
  <div class="categroy-list categroy-list-2">

    {% for block in section.blocks offset: 4 limit: 4 %}

      {% assign block_collection = block.settings.collection %}
      {% assign custom_image = block.settings.custom_image %}
      {% assign custom_title = block.settings.custom_title | strip %}

      {% if block_collection %}

        <div class="item">

          <div class="categroy-card" {{ block.shopify_attributes }}>
            {%- if block.settings.tag_text != blank -%}
              <span
                class="categroy-tag"
                style="--categroy-tag-from: {{ block.settings.tag_bg_start }}; --categroy-tag-to: {{ block.settings.tag_bg_end }}; --categroy-tag-color: {{ block.settings.tag_color }};"
                {% render 'schedule', s: block.settings %}
              >
                {{- block.settings.tag_text | escape -}}
              </span>
            {%- endif -%}
            <a href="{{ block_collection.url }}">

              <div class="categroy-thumb">

                {% if custom_image %}
                <img  src="{{ custom_image |  image_url: width: 268 }}" loading="lazy" width="134" height="146" fetchpriority="auto" class="lazyload" alt="{{ custom_title | default: block_collection.title }}" />

                    {% comment %} {{ custom_image
                    | image_url: width: 268
                    | image_tag:
                      loading: 'lazy',
                      width: 134,
                      height: 146,
                      class: 'lazyload',
                      fetchpriority: 'auto',
                      alt: custom_title | default: block_collection.title
                  }} {% endcomment %}

                {% elsif block_collection.image %}

                  {{ block_collection.image
                    | image_url: width: 268
                    | image_tag:
                      loading: 'lazy',
                      width: 134,
                      height: 146,
                      class: 'lazyload',
                      fetchpriority: 'auto',
                      alt: block_collection.title
                  }}

                {% endif %}

              </div>

              <div class="thomassmheading">
                {{ custom_title | default: block_collection.title }}
              </div>

            </a>
          </div>

        </div>

      {% endif %}

    {% endfor %}

  </div>

</div>
    {% comment %} <div class="slider-rl">
      <div class="categroy-list">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign block_collection = block.settings.collection %}
            {% assign custom_image = block.settings.custom_image %}
            {% assign custom_title = block.settings.custom_title | strip %}
            {% assign index_mod2 = forloop.index0 | modulo: 2 %}

            {%- comment -%}
              Open a new .item wrapper for every pair of cards:
              - first card (index 0)
              - then every even index (0, 2, 4, ...)
            {%- endcomment -%}
