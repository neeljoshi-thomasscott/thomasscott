<script>
  document.addEventListener('DOMContentLoaded', function () {
    const shareRoot = document.querySelector('[data-share-root]');
    if (!shareRoot) return;

    const nativeShareBtn = shareRoot.querySelector('[data-native-share]');
    const copyBtn = shareRoot.querySelector('[data-copy-link]');
    const feedback = shareRoot.querySelector('[data-share-feedback]');

    const showFeedback = (message) => {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.hidden = false;
      clearTimeout(feedback._timeout);
      feedback._timeout = setTimeout(() => {
        feedback.hidden = true;
      }, 1800);
    };

    if (nativeShareBtn) {
      nativeShareBtn.addEventListener('click', async function () {
        const title = this.getAttribute('data-share-title');
        const url = this.getAttribute('data-share-url');

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch (error) {
            /* user cancelled or share failed */
          }
        } else {
          try {
            await navigator.clipboard.writeText(url);
            showFeedback('Link copied');
          } catch (error) {
            window.prompt('Copy this link:', url);
          }
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        const url = this.getAttribute('data-share-url');
        try {
          await navigator.clipboard.writeText(url);
          showFeedback('Link copied');
        } catch (error) {
          window.prompt('Copy this link:', url);
        }
      });
    }
  });
</script>

