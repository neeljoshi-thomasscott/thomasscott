{% doc %}
  @prompt
    Please create product count and it should update automatically if any filter is applied.
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-product-count-{{ ai_gen_id }} {
  display: block;
  width: {{ block.settings.desktop_width_percent }}%;
  padding: {{ block.settings.padding }}px;
  background-color: {{ block.settings.background_color }};
  border-radius: {{ block.settings.border_radius }}px;
  text-align: {{ block.settings.text_alignment }};
}

.ai-product-count__text-{{ ai_gen_id }} {
  color: {{ block.settings.text_color }};
  font-size: {{ block.settings.font_size }}px;
  font-weight: {{ block.settings.font_weight }};
  margin: 0;
}

.ai-product-count__number-{{ ai_gen_id }} {
  color: {{ block.settings.number_color }};
  font-weight: {{ block.settings.number_font_weight }};
}

@media screen and (max-width: 749px) {
  .ai-product-count-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.mobile_text_alignment }};
  }

  .ai-product-count__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.mobile_font_size }}px;
  }
}
{% endstyle %}

<product-count-{{ ai_gen_id }}
  class="ai-product-count-{{ ai_gen_id }} thomas-product-count"
  {{ block.shopify_attributes }}
>
  <p class="ai-product-count__text-{{ ai_gen_id }}">
    
    {% if block.settings.show_prefix %}
      {{ block.settings.prefix_text }}
    {% endif %}

    <span class="ai-product-count__number-{{ ai_gen_id }}" data-count>
      {{ collection.products_count }}
    </span>

    {% if block.settings.show_suffix %}
      <span data-suffix>
        {% if collection.products_count == 1 %}
          {{ block.settings.suffix_text_singular }}
        {% else %}
          {{ block.settings.suffix_text_plural }}
        {% endif %}
      </span>
    {% endif %}

  </p>
</product-count-{{ ai_gen_id }}>

<script>
(function () {

class ProductCount{{ ai_gen_id }} extends HTMLElement {
  constructor() {
    super();
    this.countEl = this.querySelector('[data-count]');
    this.suffixEl = this.querySelector('[data-suffix]');
    this.interval = null;
  }

  connectedCallback() {
    this.updateCount();

    this.interval = setInterval(() => {
      this.updateCount();
    }, 500);
  }

  disconnectedCallback() {
    clearInterval(this.interval);
  }

  updateCount() {

    /* Horizon theme live count */
    const source = document.querySelector('.products-count-wrapper span');

    if (!source) return;

    const text = source.textContent;

    /* Extract first number */
    const match = text.match(/\d+/);

    if (match && this.countEl) {
      const count = parseInt(match[0], 10);

      this.countEl.textContent = count;

      if (this.suffixEl) {
        this.suffixEl.textContent =
          count === 1
            ? '{{ block.settings.suffix_text_singular }}'
            : '{{ block.settings.suffix_text_plural }}';
      }
    }
  }
}

customElements.define(
  'product-count-{{ ai_gen_id }}',
  ProductCount{{ ai_gen_id }}
);

})();
</script>

